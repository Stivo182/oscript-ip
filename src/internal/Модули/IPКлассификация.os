#Область СлужебныйПрограммныйИнтерфейс

// Проверяет, является ли адрес незаданным.
//
// Параметры:
//  Октеты - ФиксированныйМассив - Октеты IPv4 или IPv6-адреса.
//
// Возвращаемое значение:
//  Булево - Истина для 0.0.0.0 или ::.
Функция ЭтоНезаданный(Октеты) Экспорт

	Возврат ВсеОктетыРавны(Октеты, 0);

КонецФункции

// Проверяет, является ли адрес петлевым по RFC 1122 и RFC 4291.
//
// Параметры:
//  Октеты - ФиксированныйМассив - Октеты IPv4 или IPv6-адреса.
//
// Возвращаемое значение:
//  Булево - Истина для 127.0.0.0/8 или ::1.
Функция ЭтоПетлевой(Октеты) Экспорт

	Если Октеты.Количество() = 4 Тогда
		Возврат Октеты[0] = 127;
	КонецЕсли;

	Для Индекс = 0 По 14 Цикл
		Если Октеты[Индекс] <> 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Октеты[15] = 1;

КонецФункции

// Проверяет, является ли адрес локальным для канала по RFC 3927 и RFC 4291.
//
// Параметры:
//  Октеты - ФиксированныйМассив - Октеты IPv4 или IPv6-адреса.
//
// Возвращаемое значение:
//  Булево - Истина для 169.254.0.0/16 или fe80::/10.
Функция ЭтоЛокальныйДляКанала(Октеты) Экспорт

	Если Октеты.Количество() = 4 Тогда
		Возврат Октеты[0] = 169 И Октеты[1] = 254;
	КонецЕсли;

	Возврат Октеты[0] = 254 И Октеты[1] >= 128 И Октеты[1] <= 191;

КонецФункции

// Проверяет, относится ли адрес к частному диапазону по RFC 1918 и RFC 4193.
//
// Параметры:
//  Октеты - ФиксированныйМассив - Октеты IPv4 или IPv6-адреса.
//
// Возвращаемое значение:
//  Булево - Истина для частных IPv4-диапазонов или fc00::/7.
Функция ЭтоЧастный(Октеты) Экспорт

	Если Октеты.Количество() = 4 Тогда
		Возврат Октеты[0] = 10
			Или Октеты[0] = 172 И Октеты[1] >= 16 И Октеты[1] <= 31
			Или Октеты[0] = 192 И Октеты[1] = 168;
	КонецЕсли;

	Возврат Октеты[0] = 252 Или Октеты[0] = 253;

КонецФункции

// Проверяет, является ли адрес групповым по RFC 1112 и RFC 4291.
//
// Параметры:
//  Октеты - ФиксированныйМассив - Октеты IPv4 или IPv6-адреса.
//
// Возвращаемое значение:
//  Булево - Истина для 224.0.0.0/4 или ff00::/8.
Функция ЭтоГрупповой(Октеты) Экспорт

	Если Октеты.Количество() = 4 Тогда
		Возврат Октеты[0] >= 224 И Октеты[0] <= 239;
	КонецЕсли;

	Возврат Октеты[0] = 255;

КонецФункции

// Проверяет, предназначен ли адрес для документации по RFC 5737 и RFC 3849.
//
// Параметры:
//  Октеты - ФиксированныйМассив - Октеты IPv4 или IPv6-адреса.
//
// Возвращаемое значение:
//  Булево - Истина для диапазонов IPv4, предназначенных для документации, или 2001:db8::/32.
Функция ЭтоДляДокументации(Октеты) Экспорт

	Если Октеты.Количество() = 4 Тогда
		Возврат ЭтоIPv4ДляДокументации(Октеты);
	КонецЕсли;

	Возврат Октеты[0] = 32
		И Октеты[1] = 1
		И Октеты[2] = 13
		И Октеты[3] = 184;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВсеОктетыРавны(Октеты, Значение)

	Для Каждого Октет Из Октеты Цикл
		Если Октет <> Значение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЭтоIPv4ДляДокументации(Октеты)

	Возврат Октеты[0] = 192 И Октеты[1] = 0 И Октеты[2] = 2
		Или Октеты[0] = 198 И Октеты[1] = 51 И Октеты[2] = 100
		Или Октеты[0] = 203 И Октеты[1] = 0 И Октеты[2] = 113;

КонецФункции

#КонецОбласти
