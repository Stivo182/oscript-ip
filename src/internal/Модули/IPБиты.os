#Область СлужебныйПрограммныйИнтерфейс

// Преобразует двоичные данные IP-адреса в неизменяемую последовательность октетов.
//
// Параметры:
//  Данные - ДвоичныеДанные - Двоичное представление IP-адреса в сетевом порядке байтов.
//
// Возвращаемое значение:
//  ФиксированныйМассив - Октеты двоичного представления.
Функция ИзДвоичныхДанных(Данные) Экспорт

	ШестнадцатеричнаяСтрока = ПолучитьHexСтрокуИзДвоичныхДанных(Данные);
	Октеты = Новый Массив;
	Позиция = 1;
	Пока Позиция <= СтрДлина(ШестнадцатеричнаяСтрока) Цикл
		Октеты.Добавить(ЗначениеШестнадцатеричногоОктета(Сред(ШестнадцатеричнаяСтрока, Позиция, 2)));
		Позиция = Позиция + 2;
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Октеты);

КонецФункции

// Преобразует последовательность октетов IP-адреса в двоичные данные в сетевом порядке байтов.
//
// Параметры:
//  Октеты - Массив, ФиксированныйМассив - Октеты IP-адреса.
//
// Возвращаемое значение:
//  ДвоичныеДанные - Двоичное представление IP-адреса.
Функция ВДвоичныеДанные(Октеты) Экспорт

	ШестнадцатеричныеОктеты = Новый Массив;
	Для Каждого Октет Из Октеты Цикл
		ШестнадцатеричныеОктеты.Добавить(ШестнадцатеричнаяСтрокаОктета(Октет));
	КонецЦикла;

	ШестнадцатеричнаяСтрока = СтрСоединить(ШестнадцатеричныеОктеты, "");
	Возврат ПолучитьДвоичныеДанныеИзHexСтроки(ШестнадцатеричнаяСтрока);

КонецФункции

// Проверяет битовый шаблон IPv6-адреса с отображённым IPv4 по RFC 4291.
//
// Параметры:
//  Октеты - Массив, ФиксированныйМассив - Шестнадцать октетов IPv6-адреса.
//
// Возвращаемое значение:
//  Булево - Истина, если первые 80 бит равны нулю, а следующие 16 бит равны ffff.
Функция ЭтоIPv6СОтображеннымIPv4(Октеты) Экспорт

	Для Индекс = 0 По 9 Цикл
		Если Октеты[Индекс] <> 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Октеты[10] = 255 И Октеты[11] = 255;

КонецФункции

// Сравнивает две последовательности октетов в сетевом порядке байтов.
//
// Параметры:
//  Первый - Массив, ФиксированныйМассив - Первая последовательность октетов.
//  Второй - Массив, ФиксированныйМассив - Вторая последовательность октетов.
//
// Возвращаемое значение:
//  Число - -1, если первая последовательность меньше второй; 0 при равенстве; иначе 1.
Функция Сравнить(Первый, Второй) Экспорт

	Для Индекс = 0 По Первый.Количество() - 1 Цикл
		Если Первый[Индекс] < Второй[Индекс] Тогда
			Возврат -1;
		ИначеЕсли Первый[Индекс] > Второй[Индекс] Тогда
			Возврат 1;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

// Сравнивает строки с учётом регистра по кодам символов.
//
// Параметры:
//  Левая - Строка - Первая строка.
//  Правая - Строка - Вторая строка.
//
// Возвращаемое значение:
//  Число - -1, если левая строка меньше правой; 0 при равенстве; иначе 1.
Функция СравнитьСтрокиПоКодамСимволов(Левая, Правая) Экспорт

	Позиция = 1;
	ДлинаЛевойСтроки = СтрДлина(Левая);
	ДлинаПравойСтроки = СтрДлина(Правая);
	Пока Позиция <= ДлинаЛевойСтроки И Позиция <= ДлинаПравойСтроки Цикл
		КодЛевогоСимвола = КодСимвола(Левая, Позиция);
		КодПравогоСимвола = КодСимвола(Правая, Позиция);
		Если КодЛевогоСимвола < КодПравогоСимвола Тогда
			Возврат -1;
		ИначеЕсли КодЛевогоСимвола > КодПравогоСимвола Тогда
			Возврат 1;
		КонецЕсли;

		Позиция = Позиция + 1;
	КонецЦикла;

	Если ДлинаЛевойСтроки < ДлинаПравойСтроки Тогда
		Возврат -1;
	ИначеЕсли ДлинаЛевойСтроки > ДлинаПравойСтроки Тогда
		Возврат 1;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Применяет маску длины префикса к последовательности октетов.
//
// Параметры:
//  Октеты - Массив, ФиксированныйМассив - Октеты IP-адреса.
//  ДлинаПрефикса - Число - Количество сохраняемых старших битов.
//
// Возвращаемое значение:
//  ФиксированныйМассив - Октеты с обнулёнными битами узла.
Функция ПрименитьМаску(Октеты, ДлинаПрефикса) Экспорт

	Результат = Новый Массив;
	Для Индекс = 0 По Октеты.Количество() - 1 Цикл
		Осталось = ДлинаПрефикса - Индекс * 8;
		Если Осталось <= 0 Тогда
			МаскаОктета = 0;
		ИначеЕсли Осталось >= 8 Тогда
			МаскаОктета = 255;
		Иначе
			МаскаОктета = ПобитовоеИ(ПобитовыйСдвигВлево(255, 8 - Осталось), 255);
		КонецЕсли;
		Результат.Добавить(ПобитовоеИ(Октеты[Индекс], МаскаОктета));
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Результат);

КонецФункции

// Проверяет, что биты узла после длины префикса равны нулю.
//
// Параметры:
//  Октеты - Массив, ФиксированныйМассив - Октеты IP-адреса.
//  ДлинаПрефикса - Число - Количество сетевых старших битов.
//
// Возвращаемое значение:
//  Булево - Истина, если после маскирования октеты не изменяются.
Функция БитыХостаРавныНулю(Октеты, ДлинаПрефикса) Экспорт

	МаскированныеОктеты = ПрименитьМаску(Октеты, ДлинаПрефикса);

	Возврат Сравнить(Октеты, МаскированныеОктеты) = 0;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеШестнадцатеричногоОктета(ШестнадцатеричныйОктет)

	СтаршаяПоловина = ЗначениеШестнадцатеричногоСимвола(Сред(ШестнадцатеричныйОктет, 1, 1));
	МладшаяПоловина = ЗначениеШестнадцатеричногоСимвола(Сред(ШестнадцатеричныйОктет, 2, 1));

	Возврат СтаршаяПоловина * 16 + МладшаяПоловина;

КонецФункции

Функция ЗначениеШестнадцатеричногоСимвола(ШестнадцатеричныйСимвол)

	Позиция = СтрНайти("0123456789ABCDEF", ВРег(ШестнадцатеричныйСимвол));
	Возврат Позиция - 1;

КонецФункции

Функция ШестнадцатеричнаяСтрокаОктета(Октет)

	СтаршаяПоловина = Цел(Октет / 16);
	МладшаяПоловина = Октет - СтаршаяПоловина * 16;
	ШестнадцатеричныеСимволы = "0123456789ABCDEF";

	Возврат Сред(ШестнадцатеричныеСимволы, СтаршаяПоловина + 1, 1)
		+ Сред(ШестнадцатеричныеСимволы, МладшаяПоловина + 1, 1);

КонецФункции

#КонецОбласти
