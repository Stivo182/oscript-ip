#Область СлужебныйПрограммныйИнтерфейс

// Преобразует двоичные данные IP-адреса в неизменяемую последовательность октетов.
//
// Параметры:
//  Данные - ДвоичныеДанные - Двоичное представление IP-адреса в network byte order.
//
// Возвращаемое значение:
//  ФиксированныйМассив - Октеты двоичного представления.
Функция ИзДвоичныхДанных(Данные) Экспорт

	Hex = ПолучитьHexСтрокуИзДвоичныхДанных(Данные);
	Октеты = Новый Массив;
	Позиция = 1;
	Пока Позиция <= СтрДлина(Hex) Цикл
		Октеты.Добавить(ЗначениеHexОктета(Сред(Hex, Позиция, 2)));
		Позиция = Позиция + 2;
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Октеты);

КонецФункции

// Преобразует последовательность октетов IP-адреса в двоичные данные network byte order.
//
// Параметры:
//  Октеты - Массив, ФиксированныйМассив - Октеты IP-адреса.
//
// Возвращаемое значение:
//  ДвоичныеДанные - Двоичное представление IP-адреса.
Функция ВДвоичныеДанные(Октеты) Экспорт

	Hex = "";
	Для Каждого Октет Из Октеты Цикл
		Hex = Hex + HexОктета(Октет);
	КонецЦикла;

	Возврат ПолучитьДвоичныеДанныеИзHexСтроки(Hex);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеHexОктета(HexОктет)

	СтаршаяПоловина = ЗначениеHexСимвола(Сред(HexОктет, 1, 1));
	МладшаяПоловина = ЗначениеHexСимвола(Сред(HexОктет, 2, 1));

	Возврат СтаршаяПоловина * 16 + МладшаяПоловина;

КонецФункции

Функция ЗначениеHexСимвола(HexСимвол)

	Позиция = СтрНайти("0123456789ABCDEF", ВРег(HexСимвол));
	Возврат Позиция - 1;

КонецФункции

Функция HexОктета(Октет)

	СтаршаяПоловина = Цел(Октет / 16);
	МладшаяПоловина = Октет - СтаршаяПоловина * 16;
	HexСимволы = "0123456789ABCDEF";

	Возврат Сред(HexСимволы, СтаршаяПоловина + 1, 1)
		+ Сред(HexСимволы, МладшаяПоловина + 1, 1);

КонецФункции

#КонецОбласти
