#Область СлужебныйПрограммныйИнтерфейс

// Преобразует двоичные данные IP-адреса в неизменяемую последовательность октетов.
//
// Параметры:
//  Данные - ДвоичныеДанные - Двоичное представление IP-адреса в сетевом порядке байтов.
//
// Возвращаемое значение:
//  ФиксированныйМассив - Октеты двоичного представления.
Функция ИзДвоичныхДанных(Данные) Экспорт

	ШестнадцатеричнаяСтрока = ПолучитьHexСтрокуИзДвоичныхДанных(Данные);
	Октеты = Новый Массив;
	Позиция = 1;
	Пока Позиция <= СтрДлина(ШестнадцатеричнаяСтрока) Цикл
		Октеты.Добавить(ЗначениеШестнадцатеричногоОктета(Сред(ШестнадцатеричнаяСтрока, Позиция, 2)));
		Позиция = Позиция + 2;
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Октеты);

КонецФункции

// Преобразует последовательность октетов IP-адреса в двоичные данные в сетевом порядке байтов.
//
// Параметры:
//  Октеты - Массив, ФиксированныйМассив - Октеты IP-адреса.
//
// Возвращаемое значение:
//  ДвоичныеДанные - Двоичное представление IP-адреса.
Функция ВДвоичныеДанные(Октеты) Экспорт

	ШестнадцатеричнаяСтрока = "";
	Для Каждого Октет Из Октеты Цикл
		ШестнадцатеричнаяСтрока = ШестнадцатеричнаяСтрока + ШестнадцатеричнаяСтрокаОктета(Октет);
	КонецЦикла;

	Возврат ПолучитьДвоичныеДанныеИзHexСтроки(ШестнадцатеричнаяСтрока);

КонецФункции

// Проверяет битовый шаблон IPv6-адреса с отображённым IPv4 по RFC 4291.
//
// Параметры:
//  Октеты - Массив, ФиксированныйМассив - Шестнадцать октетов IPv6-адреса.
//
// Возвращаемое значение:
//  Булево - Истина, если первые 80 бит равны нулю, а следующие 16 бит равны ffff.
Функция ЭтоIPv6СОтображеннымIPv4(Октеты) Экспорт

	Для Индекс = 0 По 9 Цикл
		Если Октеты[Индекс] <> 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Октеты[10] = 255 И Октеты[11] = 255;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеШестнадцатеричногоОктета(ШестнадцатеричныйОктет)

	СтаршаяПоловина = ЗначениеШестнадцатеричногоСимвола(Сред(ШестнадцатеричныйОктет, 1, 1));
	МладшаяПоловина = ЗначениеШестнадцатеричногоСимвола(Сред(ШестнадцатеричныйОктет, 2, 1));

	Возврат СтаршаяПоловина * 16 + МладшаяПоловина;

КонецФункции

Функция ЗначениеШестнадцатеричногоСимвола(ШестнадцатеричныйСимвол)

	Позиция = СтрНайти("0123456789ABCDEF", ВРег(ШестнадцатеричныйСимвол));
	Возврат Позиция - 1;

КонецФункции

Функция ШестнадцатеричнаяСтрокаОктета(Октет)

	СтаршаяПоловина = Цел(Октет / 16);
	МладшаяПоловина = Октет - СтаршаяПоловина * 16;
	ШестнадцатеричныеСимволы = "0123456789ABCDEF";

	Возврат Сред(ШестнадцатеричныеСимволы, СтаршаяПоловина + 1, 1)
		+ Сред(ШестнадцатеричныеСимволы, МладшаяПоловина + 1, 1);

КонецФункции

#КонецОбласти
