#Использовать errors

#Область СлужебныйПрограммныйИнтерфейс

// Создаёт структурированную ошибку IP-адреса.
//
// Параметры:
//  Код - Строка - Стабильный машинный код ошибки.
//  Сообщение - Строка - Человекочитаемое описание ошибки.
//  Компонент - Строка, Неопределено - Компонент входного значения.
//  Ожидание - Строка, Неопределено - Ожидаемое значение или формат.
//  Причина - ИнформацияОбОшибке, Неопределено - Причина создаваемой ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Созданная структурированная ошибка.
Функция Создать(
	Код,
	Сообщение,
	Компонент = Неопределено,
	Ожидание = Неопределено,
	Причина = Неопределено
) Экспорт

	Данные = Новый Структура;
	Если Компонент <> Неопределено Тогда
		Данные.Вставить("Компонент", Компонент);
	КонецЕсли;
	Если Ожидание <> Неопределено Тогда
		Данные.Вставить("Ожидание", Ожидание);
	КонецЕсли;

	Если Причина = Неопределено Тогда
		Возврат ФабрикаОшибок.Создать(Код, Сообщение, Данные);
	КонецЕсли;

	Возврат ФабрикаОшибок.Обернуть(Причина, Код, Сообщение, Данные);

КонецФункции

#КонецОбласти
