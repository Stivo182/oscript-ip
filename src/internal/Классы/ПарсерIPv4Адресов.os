#Область СлужебныйПрограммныйИнтерфейс

// Разбирает строгое точечно-десятичное представление IPv4-адреса.
//
// Параметры:
//  Представление - Строка - IPv4-адрес из четырёх десятичных октетов.
//
// Возвращаемое значение:
//  ФиксированныйМассив - Четыре октета IPv4-адреса.
//
// Исключения:
//  ip.invalid_ipv4 - Представление не соответствует строгому формату IPv4.
Функция Разобрать(Представление) Экспорт

	Октеты = Новый Массив(4);
	ИндексОктета = 0;
	ЗначениеОктета = 0;
	ДлинаОктета = 0;
	ПервыйСимволНоль = Ложь;
	КоличествоТочек = 0;
	ДлинаПредставления = СтрДлина(Представление);

	Для Позиция = 1 По ДлинаПредставления Цикл
		Код = КодСимвола(Представление, Позиция);

		Если Код = 46 Тогда
			Если ДлинаОктета = 0 Тогда
				ВызватьОшибкуРазбора();
			КонецЕсли;

			Октеты[ИндексОктета] = ЗначениеОктета;
			ИндексОктета = ИндексОктета + 1;
			КоличествоТочек = КоличествоТочек + 1;

			Если КоличествоТочек > 3 Тогда
				ВызватьОшибкуРазбора();
			КонецЕсли;

			ЗначениеОктета = 0;
			ДлинаОктета = 0;
			ПервыйСимволНоль = Ложь;

			Продолжить;
		КонецЕсли;

		Если Код < 48 Или Код > 57 Тогда
			ВызватьОшибкуРазбора();
		КонецЕсли;

		Если ДлинаОктета = 0 Тогда
			ПервыйСимволНоль = Код = 48;
		КонецЕсли;

		ДлинаОктета = ДлинаОктета + 1;
		Если ДлинаОктета > 3 Или ДлинаОктета > 1 И ПервыйСимволНоль Тогда
			ВызватьОшибкуРазбора();
		КонецЕсли;

		ЗначениеОктета = ЗначениеОктета * 10 + Код - 48;
		Если ЗначениеОктета > 255 Тогда
			ВызватьОшибкуРазбора();
		КонецЕсли;
	КонецЦикла;

	Если ДлинаОктета = 0 Тогда
		ВызватьОшибкуРазбора();
	КонецЕсли;

	Октеты[ИндексОктета] = ЗначениеОктета;
	Если КоличествоТочек <> 3 Тогда
		ВызватьОшибкуРазбора();
	КонецЕсли;

	Возврат Новый ФиксированныйМассив(Октеты);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВызватьОшибкуРазбора()

	ВызватьИсключение ФабрикаОшибокIP.Создать(
		КодыОшибокIP.НедопустимыйIPv4(),
		"Недопустимое представление IPv4-адреса",
		"Адрес",
		"четыре десятичных октета от 0 до 255"
	);

КонецПроцедуры

#КонецОбласти
