#Область СлужебныйПрограммныйИнтерфейс

// Разбирает строгое dotted-decimal представление IPv4-адреса.
//
// Параметры:
//  Представление - Строка - IPv4-адрес из четырёх десятичных октетов.
//
// Возвращаемое значение:
//  ФиксированныйМассив - Четыре октета IPv4-адреса.
//
// Исключения:
//  ip.invalid_ipv4 - Представление не соответствует строгому формату IPv4.
Функция Разобрать(Представление) Экспорт

	Октеты = Новый Массив;
	ЗначениеОктета = 0;
	ДлинаОктета = 0;
	ПервыйСимволОктета = "";
	КоличествоТочек = 0;

	Для Позиция = 1 По СтрДлина(Представление) Цикл
		Символ = Сред(Представление, Позиция, 1);
		Если Символ = "." Тогда
			ДобавитьОктет(Октеты, ЗначениеОктета, ДлинаОктета, Позиция);
			КоличествоТочек = КоличествоТочек + 1;
			Если КоличествоТочек > 3 Тогда
				ВызватьОшибкуРазбора(Позиция);
			КонецЕсли;
			ЗначениеОктета = 0;
			ДлинаОктета = 0;
			ПервыйСимволОктета = "";
			Продолжить;
		КонецЕсли;

		Код = КодСимвола(Символ);
		Если Код < 48 Или Код > 57 Тогда
			ВызватьОшибкуРазбора(Позиция);
		КонецЕсли;

		Если ДлинаОктета = 0 Тогда
			ПервыйСимволОктета = Символ;
		КонецЕсли;
		ДлинаОктета = ДлинаОктета + 1;
		Если ДлинаОктета > 3 Или ДлинаОктета > 1 И ПервыйСимволОктета = "0" Тогда
			ВызватьОшибкуРазбора(Позиция);
		КонецЕсли;

		ЗначениеОктета = ЗначениеОктета * 10 + Код - 48;
		Если ЗначениеОктета > 255 Тогда
			ВызватьОшибкуРазбора(Позиция);
		КонецЕсли;
	КонецЦикла;

	ДобавитьОктет(Октеты, ЗначениеОктета, ДлинаОктета, СтрДлина(Представление) + 1);
	Если КоличествоТочек <> 3 Или Октеты.Количество() <> 4 Тогда
		ВызватьОшибкуРазбора(СтрДлина(Представление) + 1);
	КонецЕсли;

	Возврат Новый ФиксированныйМассив(Октеты);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьОктет(Октеты, ЗначениеОктета, ДлинаОктета, Позиция)

	Если ДлинаОктета = 0 Тогда
		ВызватьОшибкуРазбора(Позиция);
	КонецЕсли;

	Октеты.Добавить(ЗначениеОктета);

КонецПроцедуры

Процедура ВызватьОшибкуРазбора(Позиция)

	ВызватьИсключение ОшибкиIP.Создать(
		КодыОшибокIP.НедопустимыйIPv4(),
		"Недопустимое представление IPv4-адреса",
		"Адрес",
		Позиция,
		"четыре десятичных октета от 0 до 255"
	);

КонецПроцедуры

#КонецОбласти
