#Область СлужебныйПрограммныйИнтерфейс

// Разбирает IP-адрес и длину префикса из строки CIDR.
//
// Ссылки:
//  RFC 4632 §3.1 - бесклассовая адресация IPv4 и запись CIDR:
//  https://www.rfc-editor.org/rfc/rfc4632.html#section-3.1
//  RFC 4291 §2.3 - текстовая запись префиксов IPv6:
//  https://www.rfc-editor.org/rfc/rfc4291.html#section-2.3
//
// Параметры:
//  Представление - Строка - IP-адрес и длина префикса в записи CIDR.
//
// Возвращаемое значение:
//  Структура - Адрес и ДлинаПрефикса.
//
// Исключения:
//  ip.invalid_prefix - Представление не соответствует формату IP-префикса.
//  ip.prefix_length_out_of_range - Длина префикса не соответствует семейству IP-адреса.
Функция Разобрать(Представление) Экспорт

	ПозицияРазделителя = СтрНайти(Представление, "/");
	Если ПозицияРазделителя = 0 Тогда
		ВызватьОшибкуНедопустимогоПрефикса();
	КонецЕсли;

	СтрокаАдреса = Лев(Представление, ПозицияРазделителя - 1);
	СтрокаДлины = Сред(Представление, ПозицияРазделителя + 1);
	ЕстьВторойРазделитель = СтрНайти(СтрокаДлины, "/") > 0;

	Если ЕстьВторойРазделитель
		Или ПустаяСтрока(СтрокаАдреса)
		Или ПустаяСтрока(СтрокаДлины) Тогда
		ВызватьОшибкуНедопустимогоПрефикса();
	КонецЕсли;

	Попытка
		Адрес = Новый IPАдрес(СтрокаАдреса);
	Исключение
		Причина = ИнформацияОбОшибке();
		ВызватьОшибкуНедопустимогоПрефикса(Причина, "Адрес", "IPv4 или IPv6");
	КонецПопытки;

	Если Адрес.ИмеетЗону() Тогда
		ВызватьОшибкуНедопустимогоПрефикса(Неопределено, "Зона", "адрес без зоны");
	КонецЕсли;

	ДлинаПрефикса = РазобратьДлинуПрефикса(СтрокаДлины, Адрес.ДлинаВБитах());

	Возврат Новый Структура(
		"Адрес,ДлинаПрефикса",
		Адрес,
		ДлинаПрефикса
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьДлинуПрефикса(СтрокаДлины, МаксимальнаяДлина)

	Если СтрДлина(СтрокаДлины) > 1 И Лев(СтрокаДлины, 1) = "0" Тогда
		ВызватьОшибкуНедопустимогоПрефикса(
			Неопределено,
			"ДлинаПрефикса",
			"целое число без ведущих нулей"
		);
	КонецЕсли;

	Результат = 0;
	Для Позиция = 1 По СтрДлина(СтрокаДлины) Цикл
		Код = КодСимвола(СтрокаДлины, Позиция);
		Если Код < 48 Или Код > 57 Тогда
			ВызватьОшибкуНедопустимогоПрефикса(
				Неопределено,
				"ДлинаПрефикса",
				"целое число без ведущих нулей"
			);
		КонецЕсли;

		Результат = Результат * 10 + Код - 48;
		Если Результат > МаксимальнаяДлина Тогда
			ВызватьИсключение ФабрикаОшибокIP.Создать(
				КодыОшибокIP.ДлинаПрефиксаВнеДиапазона(),
				"Длина префикса не соответствует семейству IP-адреса",
				"ДлинаПрефикса",
				"от 0 до " + Строка(МаксимальнаяДлина) + " включительно"
			);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ВызватьОшибкуНедопустимогоПрефикса(
	Причина = Неопределено,
	Компонент = "Префикс",
	Ожидание = "адрес/длина"
)

	ВызватьИсключение ФабрикаОшибокIP.Создать(
		КодыОшибокIP.НедопустимыйПрефикс(),
		"Строка не является строгим IP-префиксом",
		Компонент,
		Ожидание,
		Причина
	);

КонецПроцедуры

#КонецОбласти
