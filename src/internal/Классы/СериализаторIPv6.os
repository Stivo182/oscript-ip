Перем _Октеты; // ФиксированныйМассив

#Область ОбработчикиСобытий

// Создаёт сериализатор текстовых представлений IPv6-адреса.
//
// Параметры:
//  Октеты - Массив, ФиксированныйМассив - Шестнадцать октетов IPv6-адреса.
Процедура ПриСозданииОбъекта(Октеты)

	Копия = Новый Массив;
	Для Каждого Октет Из Октеты Цикл
		Копия.Добавить(Октет);
	КонецЦикла;

	_Октеты = Новый ФиксированныйМассив(Копия);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает каноническое текстовое представление IPv6-адреса по RFC 5952.
//
// Возвращаемое значение:
//  Строка - Каноническое текстовое представление IPv6-адреса без зоны.
Функция ВСтроку() Экспорт

	Если IPБиты.ЭтоIPv6СОтображеннымIPv4(_Октеты) Тогда
		Возврат "::ffff:" + СтрокаIPv4(12);
	КонецЕсли;

	Группы = ГруппыИзОктетов();
	ДанныеСжатия = ДанныеСжатияНулей(Группы);
	Если ДанныеСжатия.Длина < 2 Тогда
		Возврат СтрокаГрупп(Группы, 0, 7, Ложь);
	КонецЕсли;

	ЛеваяЧасть = СтрокаГрупп(Группы, 0, ДанныеСжатия.Начало - 1, Ложь);
	ПраваяЧасть = СтрокаГрупп(
		Группы,
		ДанныеСжатия.Начало + ДанныеСжатия.Длина,
		7,
		Ложь
	);

	Если ПустаяСтрока(ЛеваяЧасть) И ПустаяСтрока(ПраваяЧасть) Тогда
		Возврат "::";
	ИначеЕсли ПустаяСтрока(ЛеваяЧасть) Тогда
		Возврат "::" + ПраваяЧасть;
	ИначеЕсли ПустаяСтрока(ПраваяЧасть) Тогда
		Возврат ЛеваяЧасть + "::";
	КонецЕсли;

	Возврат ЛеваяЧасть + "::" + ПраваяЧасть;

КонецФункции

// Возвращает развёрнутое текстовое представление IPv6-адреса.
//
// Возвращаемое значение:
//  Строка - Восемь групп из четырёх строчных шестнадцатеричных цифр.
Функция РазвернутаяСтрока() Экспорт

	Возврат СтрокаГрупп(ГруппыИзОктетов(), 0, 7, Истина);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ГруппыИзОктетов()

	Группы = Новый Массив;
	Для ИндексГруппы = 0 По 7 Цикл
		ИндексОктета = ИндексГруппы * 2;
		Группы.Добавить(_Октеты[ИндексОктета] * 256 + _Октеты[ИндексОктета + 1]);
	КонецЦикла;

	Возврат Группы;

КонецФункции

Функция ДанныеСжатияНулей(Группы)

	НачалоЛучшейПоследовательности = -1;
	ДлинаЛучшейПоследовательности = 0;
	НачалоТекущейПоследовательности = -1;
	ДлинаТекущейПоследовательности = 0;

	Для Индекс = 0 По 8 Цикл
		Если Индекс < 8 И Группы[Индекс] = 0 Тогда
			Если ДлинаТекущейПоследовательности = 0 Тогда
				НачалоТекущейПоследовательности = Индекс;
			КонецЕсли;
			ДлинаТекущейПоследовательности = ДлинаТекущейПоследовательности + 1;
			Продолжить;
		КонецЕсли;

		Если ДлинаТекущейПоследовательности > ДлинаЛучшейПоследовательности Тогда
			НачалоЛучшейПоследовательности = НачалоТекущейПоследовательности;
			ДлинаЛучшейПоследовательности = ДлинаТекущейПоследовательности;
		КонецЕсли;
		ДлинаТекущейПоследовательности = 0;
	КонецЦикла;

	Возврат Новый Структура(
		"Начало,Длина",
		НачалоЛучшейПоследовательности,
		ДлинаЛучшейПоследовательности
	);

КонецФункции

Функция СтрокаГрупп(Группы, Начало, Конец, Развернутая)

	Результат = "";
	Для Индекс = Начало По Конец Цикл
		Если Не ПустаяСтрока(Результат) Тогда
			Результат = Результат + ":";
		КонецЕсли;
		Результат = Результат + ШестнадцатеричнаяГруппа(Группы[Индекс], Развернутая);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ШестнадцатеричнаяГруппа(Группа, Развернутая)

	ШестнадцатеричныеСимволы = "0123456789abcdef";
	Результат = "";
	КоличествоЦифр = ?(Развернутая, 4, 1);

	Пока Группа > 0 Или СтрДлина(Результат) < КоличествоЦифр Цикл
		МладшаяЦифра = Группа - Цел(Группа / 16) * 16;
		Результат = Сред(ШестнадцатеричныеСимволы, МладшаяЦифра + 1, 1) + Результат;
		Группа = Цел(Группа / 16);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СтрокаIPv4(Начало)

	Возврат Строка(_Октеты[Начало]) + "."
		+ Строка(_Октеты[Начало + 1]) + "."
		+ Строка(_Октеты[Начало + 2]) + "."
		+ Строка(_Октеты[Начало + 3]);

КонецФункции

#КонецОбласти
