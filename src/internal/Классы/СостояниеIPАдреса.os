Перем _Октеты; // ФиксированныйМассив
Перем _Зона;   // Строка, Неопределено

#Область ОбработчикиСобытий

// Создаёт неизменяемое состояние IP-адреса.
//
// Параметры:
//  Октеты - Массив, ФиксированныйМассив - Последовательность проверенных октетов IP-адреса.
//  Зона - Строка, Неопределено - Необязательная зона IPv6-адреса.
Процедура ПриСозданииОбъекта(Октеты, Зона = Неопределено)

	Копия = Новый Массив;
	Для Каждого Октет Из Октеты Цикл
		Копия.Добавить(Октет);
	КонецЦикла;

	_Октеты = Новый ФиксированныйМассив(Копия);
	_Зона = Зона;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает версию IP-адреса.
//
// Возвращаемое значение:
//  Число - 4 для IPv4 или 6 для IPv6.
Функция Версия() Экспорт

	Если _Октеты.Количество() = 4 Тогда
		Возврат 4;
	КонецЕсли;

	Возврат 6;

КонецФункции

// Проверяет принадлежность адреса к IPv4.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес относится к IPv4.
Функция ЭтоIPv4() Экспорт

	Возврат Версия() = 4;

КонецФункции

// Проверяет принадлежность адреса к IPv6.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес относится к IPv6.
Функция ЭтоIPv6() Экспорт

	Возврат Версия() = 6;

КонецФункции

// Возвращает длину адреса в битах.
//
// Возвращаемое значение:
//  Число - 32 для IPv4 или 128 для IPv6.
Функция ДлинаВБитах() Экспорт

	Возврат _Октеты.Количество() * 8;

КонецФункции

// Возвращает двоичное представление адреса в сетевом порядке байтов.
//
// Возвращаемое значение:
//  ДвоичныеДанные - Четыре байта для IPv4 или шестнадцать байтов для IPv6.
Функция Байты() Экспорт

	Возврат IPБиты.ВДвоичныеДанные(_Октеты);

КонецФункции

// Возвращает новую неизменяемую коллекцию октетов адреса.
//
// Возвращаемое значение:
//  ФиксированныйМассив - Новая неизменяемая последовательность из 4 или 16 октетов.
Функция Октеты() Экспорт

	Копия = Новый Массив;
	Для Каждого Октет Из _Октеты Цикл
		Копия.Добавить(Октет);
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Копия);

КонецФункции

// Проверяет наличие зоны IPv6-адреса.
//
// Возвращаемое значение:
//  Булево - Истина, если у IPv6-адреса задана зона.
Функция ЕстьЗона() Экспорт

	Возврат _Зона <> Неопределено;

КонецФункции

// Возвращает зону IPv6-адреса.
//
// Возвращаемое значение:
//  Строка, Неопределено - Зона IPv6-адреса или Неопределено.
Функция Зона() Экспорт

	Возврат _Зона;

КонецФункции

#КонецОбласти
