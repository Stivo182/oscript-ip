#Использовать errors

#Область СлужебныйПрограммныйИнтерфейс

// Разбирает текстовое представление IPv6-адреса по RFC 4291.
//
// Параметры:
//  Представление - Строка - IPv6-адрес с необязательной зоной.
//  Зона отделяется символом `%`.
//
// Возвращаемое значение:
//  Структура - Октеты IPv6-адреса и необязательная зона.
//
// Исключения:
//  argument.invalid_type - Представление имеет недопустимый тип.
//  ip.invalid_ipv6 - Представление не соответствует синтаксису IPv6, описанному в RFC 4291.
Функция Разобрать(Представление) Экспорт

	Если ТипЗнч(Представление) <> Тип("Строка") Тогда
		ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
			"Представление",
			"Строка",
			Представление
		);
	КонецЕсли;

	АдреснаяЧасть = Представление;
	Зона = Неопределено;
	РазделитьПредставление(Представление, АдреснаяЧасть, Зона);
	Группы = РазобратьАдреснуюЧасть(АдреснаяЧасть);
	Октеты = ОктетыИзГрупп(Группы);

	Если Зона <> Неопределено
		И Не ЗонаДопустимаДляАдреса(Октеты) Тогда
		ВызватьОшибкуНедопустимойЗоны();
	КонецЕсли;

	Возврат СоздатьРезультатРазбора(Октеты, Зона);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьРезультатРазбора(Октеты, Зона)

	Возврат Новый Структура("Октеты,Зона", Октеты, Зона);

КонецФункции

Процедура РазделитьПредставление(Представление, Адрес, Зона)

	Адрес = Представление;
	Зона = Неопределено;
	ПозицияЗоны = СтрНайти(Представление, "%");

	Если ПозицияЗоны = 0 Тогда
		Возврат;
	КонецЕсли;

	Адрес = Лев(Представление, ПозицияЗоны - 1);
	Зона = Сред(Представление, ПозицияЗоны + 1);

	Если Не ЗонаДопустима(Зона) Тогда
		Попытка
			ВызватьОшибкуНедопустимойЗоны();
		Исключение
			ВызватьОшибкуРазбора(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Функция РазобратьАдреснуюЧасть(Адрес)

	Если ПустаяСтрока(Адрес) Тогда
		ВызватьОшибкуРазбора();
	КонецЕсли;

	ПозицияСжатия = СтрНайти(Адрес, "::");
	Если ПозицияСжатия > 0
		И СтрНайти(Сред(Адрес, ПозицияСжатия + 1), "::") > 0 Тогда
		ВызватьОшибкуРазбора();
	КонецЕсли;

	Если ПозицияСжатия = 0 Тогда
		Группы = ГруппыИзСтороны(Адрес, Ложь, Истина);
		Если Группы.Количество() > 8 Тогда
			ВызватьОшибкуРазбора();
		КонецЕсли;
	Иначе
		ЛеваяСторона = Лев(Адрес, ПозицияСжатия - 1);
		ПраваяСторона = Сред(Адрес, ПозицияСжатия + 2);
		ЛевыеГруппы = ГруппыИзСтороны(ЛеваяСторона, Истина, Ложь);
		ПравыеГруппы = ГруппыИзСтороны(ПраваяСторона, Истина, Истина);
		Если ЛевыеГруппы.Количество() + ПравыеГруппы.Количество() >= 8 Тогда
			ВызватьОшибкуРазбора();
		КонецЕсли;
		Группы = ВосстановитьСжатыеГруппы(ЛевыеГруппы, ПравыеГруппы);
	КонецЕсли;

	Если Группы.Количество() <> 8 Тогда
		ВызватьОшибкуРазбора();
	КонецЕсли;

	Возврат Группы;

КонецФункции

Функция ГруппыИзСтороны(Сторона, РазрешитьПустую, РазрешитьIPv4)

	Если ПустаяСтрока(Сторона) Тогда
		Если Не РазрешитьПустую Тогда
			ВызватьОшибкуРазбора();
		КонецЕсли;

		Возврат Новый Массив;
	КонецЕсли;

	Группы = Новый Массив;
	НачалоТокена = 1;
	ДлинаСтороны = СтрДлина(Сторона);
	ЭтоIPv4 = Ложь;

	Для Позиция = 1 По ДлинаСтороны + 1 Цикл
		Если Позиция <= ДлинаСтороны Тогда
			Код = КодСимвола(Сторона, Позиция);
			Если Код = 46 Тогда
				ЭтоIPv4 = Истина;
			КонецЕсли;

			Если Код <> 58 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		ДлинаТокена = Позиция - НачалоТокена;
		Если ДлинаТокена = 0 Тогда
			ВызватьОшибкуРазбора();
		КонецЕсли;

		ЭтоПоследнийТокен = Позиция > ДлинаСтороны;
		Если ЭтоIPv4 И (Не РазрешитьIPv4 Или Не ЭтоПоследнийТокен) Тогда
			ВызватьОшибкуРазбора();
		КонецЕсли;

		Если ЭтоIPv4 Тогда
			ДобавитьГруппыIPv4(Группы, Сред(Сторона, НачалоТокена, ДлинаТокена));
		Иначе
			Группы.Добавить(ЗначениеШестнадцатеричнойГруппы(Сторона, НачалоТокена, ДлинаТокена));
		КонецЕсли;

		НачалоТокена = Позиция + 1;
		ЭтоIPv4 = Ложь;
	КонецЦикла;

	Возврат Группы;

КонецФункции

Процедура ДобавитьГруппыIPv4(Группы, Токен)

	Попытка
		ОктетыIPv4 = Новый ПарсерIPv4Адресов().Разобрать(Токен);
	Исключение
		Причина = ИнформацияОбОшибке();
		ВызватьОшибкуРазбора(Причина);
	КонецПопытки;

	Группы.Добавить(ОктетыIPv4[0] * 256 + ОктетыIPv4[1]);
	Группы.Добавить(ОктетыIPv4[2] * 256 + ОктетыIPv4[3]);

КонецПроцедуры

Функция ЗначениеШестнадцатеричнойГруппы(Представление, Начало, Длина)

	Если Длина > 4 Тогда
		ВызватьОшибкуРазбора();
	КонецЕсли;

	ЗначениеГруппы = 0;
	Для Позиция = Начало По Начало + Длина - 1 Цикл
		Код = КодСимвола(Представление, Позиция);
		Если Код >= 48 И Код <= 57 Тогда
			ЗначениеСимвола = Код - 48;
		ИначеЕсли Код >= 65 И Код <= 70 Тогда
			ЗначениеСимвола = Код - 65 + 10;
		ИначеЕсли Код >= 97 И Код <= 102 Тогда
			ЗначениеСимвола = Код - 97 + 10;
		Иначе
			ВызватьОшибкуРазбора();
		КонецЕсли;
		ЗначениеГруппы = ЗначениеГруппы * 16 + ЗначениеСимвола;
	КонецЦикла;

	Возврат ЗначениеГруппы;

КонецФункции

Функция ВосстановитьСжатыеГруппы(ЛевыеГруппы, ПравыеГруппы)

	КоличествоНулей = 8 - ЛевыеГруппы.Количество() - ПравыеГруппы.Количество();
	Если КоличествоНулей < 1 Тогда
		ВызватьОшибкуРазбора();
	КонецЕсли;

	Группы = Новый Массив(8);
	ИндексРезультата = 0;
	Для Каждого Группа Из ЛевыеГруппы Цикл
		Группы[ИндексРезультата] = Группа;
		ИндексРезультата = ИндексРезультата + 1;
	КонецЦикла;

	Для Индекс = 1 По КоличествоНулей Цикл
		Группы[ИндексРезультата] = 0;
		ИндексРезультата = ИндексРезультата + 1;
	КонецЦикла;

	Для Каждого Группа Из ПравыеГруппы Цикл
		Группы[ИндексРезультата] = Группа;
		ИндексРезультата = ИндексРезультата + 1;
	КонецЦикла;

	Возврат Группы;

КонецФункции

Функция ОктетыИзГрупп(Группы)

	Октеты = Новый Массив(16);
	ИндексОктета = 0;

	Для Каждого Группа Из Группы Цикл
		СтаршийОктет = Цел(Группа / 256);
		Октеты[ИндексОктета] = СтаршийОктет;
		Октеты[ИндексОктета + 1] = Группа - СтаршийОктет * 256;
		ИндексОктета = ИндексОктета + 2;
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Октеты);

КонецФункции

Функция ЗонаДопустимаДляАдреса(Октеты)

	ЭтоЛокальныйДляКанала = Октеты[0] = 254
		И Октеты[1] >= 128
		И Октеты[1] <= 191;

	Если ЭтоЛокальныйДляКанала Тогда
		Возврат Истина;
	КонецЕсли;

	Если Октеты[0] <> 255 Тогда
		Возврат Ложь;
	КонецЕсли;

	ОбластьГрупповогоАдреса = Октеты[1] - Цел(Октеты[1] / 16) * 16;

	Возврат ОбластьГрупповогоАдреса >= 1 И ОбластьГрупповогоАдреса <= 13;

КонецФункции

Функция ЗонаДопустима(Зона)

	Если СтрДлина(Зона) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Зона) Цикл
		Символ = Сред(Зона, Позиция, 1);
		Если Символ = "%"
			Или Символ = "["
			Или Символ = "]"
			Или Символ = Символы.ВК
			Или Символ = Символы.ПС
			Или КодСимвола(Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура ВызватьОшибкуРазбора(Причина = Неопределено)

	ВызватьИсключение ФабрикаОшибокIP.Создать(
		КодыОшибокIP.НедопустимыйIPv6(),
		"Недопустимое представление IPv6-адреса",
		"Адрес",
		"IPv6 по RFC 4291",
		Причина
	);

КонецПроцедуры

Процедура ВызватьОшибкуНедопустимойЗоны()

	ВызватьИсключение ФабрикаОшибокIP.Создать(
		КодыОшибокIP.НедопустимаяЗона(),
		"Недопустимая зона IPv6-адреса",
		"Зона",
		"непустой идентификатор зоны для адреса допустимой области действия"
	);

КонецПроцедуры

#КонецОбласти
