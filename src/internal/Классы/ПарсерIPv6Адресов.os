#Использовать errors

#Область СлужебныйПрограммныйИнтерфейс

// Разбирает текстовое представление IPv6-адреса по RFC 4291.
//
// Параметры:
//  Представление - Строка - IPv6-адрес с необязательной зоной.
//  Зона отделяется символом `%`.
//
// Возвращаемое значение:
//  Структура - Октеты IPv6-адреса и необязательная зона.
//
// Исключения:
//  argument.invalid_type - Представление имеет недопустимый тип.
//  ip.invalid_ipv6 - Представление не соответствует синтаксису IPv6 RFC 4291.
Функция Разобрать(Представление) Экспорт

	Если ТипЗнч(Представление) <> Тип("Строка") Тогда
		ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
			"Представление",
			"Строка",
			Представление
		);
	КонецЕсли;

	ЧастиПредставления = РазделитьПредставление(Представление);
	Группы = РазобратьАдреснуюЧасть(ЧастиПредставления.Адрес);
	Октеты = ОктетыИзГрупп(Группы);

	Если ЧастиПредставления.Зона <> Неопределено
		И Не ЗонаДопустимаДляАдреса(Октеты) Тогда
		ВызватьОшибкуНедопустимойЗоны();
	КонецЕсли;

	Возврат СоздатьРезультатРазбора(Октеты, ЧастиПредставления.Зона);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьРезультатРазбора(Октеты, Зона)

	Возврат Новый Структура("Октеты,Зона", Октеты, Зона);

КонецФункции

Функция РазделитьПредставление(Представление)

	Адрес = Представление;
	Зона = Неопределено;
	ПозицияЗоны = СтрНайти(Представление, "%");

	Если ПозицияЗоны = 0 Тогда
		Возврат Новый Структура("Адрес,Зона", Адрес, Зона);
	КонецЕсли;

	Адрес = Лев(Представление, ПозицияЗоны - 1);
	Зона = Сред(Представление, ПозицияЗоны + 1);

	Если Не ЗонаДопустима(Зона) Тогда
		Попытка
			ВызватьОшибкуНедопустимойЗоны();
		Исключение
			ВызватьОшибкуРазбора(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Возврат Новый Структура("Адрес,Зона", Адрес, Зона);

КонецФункции

Функция РазобратьАдреснуюЧасть(Адрес)

	Если ПустаяСтрока(Адрес) Тогда
		ВызватьОшибкуРазбора();
	КонецЕсли;

	Если ЕстьЛишнееСжатие(Адрес) Тогда
		ВызватьОшибкуРазбора();
	КонецЕсли;

	ПозицияСжатия = СтрНайти(Адрес, "::");
	Если ПозицияСжатия = 0 Тогда
		Токены = ТокеныИзСтороны(Адрес, Ложь);
		Группы = ГруппыИзТокенов(Токены, Истина);
		Если Группы.Количество() > 8 Тогда
			ВызватьОшибкуРазбора();
		КонецЕсли;
	Иначе
		ЛеваяСторона = Лев(Адрес, ПозицияСжатия - 1);
		ПраваяСторона = Сред(Адрес, ПозицияСжатия + 2);
		ЛевыеТокены = ТокеныИзСтороны(ЛеваяСторона, Истина);
		ПравыеТокены = ТокеныИзСтороны(ПраваяСторона, Истина);
		ЛевыеГруппы = ГруппыИзТокенов(ЛевыеТокены, Ложь);
		ПравыеГруппы = ГруппыИзТокенов(ПравыеТокены, Истина);
		Если ЛевыеГруппы.Количество() + ПравыеГруппы.Количество() >= 8 Тогда
			ВызватьОшибкуРазбора();
		КонецЕсли;
		Группы = ВосстановитьСжатыеГруппы(ЛевыеГруппы, ПравыеГруппы);
	КонецЕсли;

	Если Группы.Количество() <> 8 Тогда
		ВызватьОшибкуРазбора();
	КонецЕсли;

	Возврат Группы;

КонецФункции

Функция ЕстьЛишнееСжатие(Представление)

	ПозицияПервогоСжатия = 0;
	Для Позиция = 1 По СтрДлина(Представление) - 1 Цикл
		Если Сред(Представление, Позиция, 2) = "::" Тогда
			Если ПозицияПервогоСжатия > 0 Тогда
				Возврат Истина;
			КонецЕсли;
			ПозицияПервогоСжатия = Позиция;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ТокеныИзСтороны(Сторона, РазрешитьПустую)

	Если ПустаяСтрока(Сторона) Тогда
		Если Не РазрешитьПустую Тогда
			ВызватьОшибкуРазбора();
		КонецЕсли;

		Возврат Новый Массив;
	КонецЕсли;

	Токены = Новый Массив;
	НачалоТокена = 1;

	Для Позиция = 1 По СтрДлина(Сторона) + 1 Цикл

		ЭтоНеРазделитель = Позиция <= СтрДлина(Сторона)
			И Сред(Сторона, Позиция, 1) <> ":";

		Если ЭтоНеРазделитель Тогда
			Продолжить;
		КонецЕсли;

		Токен = Сред(Сторона, НачалоТокена, Позиция - НачалоТокена);
		Если ПустаяСтрока(Токен) Тогда
			ВызватьОшибкуРазбора();
		КонецЕсли;

		Токены.Добавить(Токен);
		НачалоТокена = Позиция + 1;
	КонецЦикла;

	Возврат Токены;

КонецФункции

Функция ГруппыИзТокенов(Токены, РазрешитьIPv4)

	Группы = Новый Массив;
	Если Токены.Количество() = 0 Тогда
		Возврат Группы;
	КонецЕсли;

	Для ИндексТокена = 0 По Токены.Количество() - 1 Цикл
		Токен = Токены[ИндексТокена];
		ЭтоIPv4 = СтрНайти(Токен, ".") > 0;
		ЭтоПоследнийТокен = ИндексТокена = Токены.Количество() - 1;
		
		Если ЭтоIPv4 И (Не РазрешитьIPv4 Или Не ЭтоПоследнийТокен) Тогда
			ВызватьОшибкуРазбора();
		КонецЕсли;

		ДобавитьЭлементы(Группы, ГруппыИзТокена(Токен));
	КонецЦикла;

	Возврат Группы;

КонецФункции

Функция ГруппыИзТокена(Токен)

	Если СтрНайти(Токен, ".") > 0 Тогда
		ТекстТокена = Токен;
		Попытка
			ОктетыIPv4 = Новый ПарсерIPv4Адресов().Разобрать(ТекстТокена);
		Исключение
			Причина = ИнформацияОбОшибке();
			ВызватьОшибкуРазбора(Причина);
		КонецПопытки;

		Группы = Новый Массив;
		Группы.Добавить(ОктетыIPv4[0] * 256 + ОктетыIPv4[1]);
		Группы.Добавить(ОктетыIPv4[2] * 256 + ОктетыIPv4[3]);
		
		Возврат Группы;
	КонецЕсли;

	Группы = Новый Массив;
	Группы.Добавить(ЗначениеШестнадцатеричнойГруппы(Токен));

	Возврат Группы;

КонецФункции

Функция ЗначениеШестнадцатеричнойГруппы(Токен)

	Если СтрДлина(Токен) < 1 Или СтрДлина(Токен) > 4 Тогда
		ВызватьОшибкуРазбора();
	КонецЕсли;

	ЗначениеГруппы = 0;
	Для Позиция = 1 По СтрДлина(Токен) Цикл
		ЗначениеСимвола = ЗначениеШестнадцатеричногоСимвола(Сред(Токен, Позиция, 1));
		Если ЗначениеСимвола = Неопределено Тогда
			ВызватьОшибкуРазбора();
		КонецЕсли;
		ЗначениеГруппы = ЗначениеГруппы * 16 + ЗначениеСимвола;
	КонецЦикла;

	Возврат ЗначениеГруппы;

КонецФункции

Функция ВосстановитьСжатыеГруппы(ЛевыеГруппы, ПравыеГруппы)

	КоличествоНулей = 8 - ЛевыеГруппы.Количество() - ПравыеГруппы.Количество();
	Если КоличествоНулей < 1 Тогда
		ВызватьОшибкуРазбора();
	КонецЕсли;

	Группы = Новый Массив;
	ДобавитьЭлементы(Группы, ЛевыеГруппы);
	
	Для Индекс = 1 По КоличествоНулей Цикл
		Группы.Добавить(0);
	КонецЦикла;

	ДобавитьЭлементы(Группы, ПравыеГруппы);

	Возврат Группы;

КонецФункции

Функция ЗначениеШестнадцатеричногоСимвола(Символ)

	Код = КодСимвола(Символ);
	Если Код >= 48 И Код <= 57 Тогда
		Возврат Код - 48;
	ИначеЕсли Код >= 65 И Код <= 70 Тогда
		Возврат Код - 65 + 10;
	ИначеЕсли Код >= 97 И Код <= 102 Тогда
		Возврат Код - 97 + 10;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Процедура ДобавитьЭлементы(Приемник, Источник)

	Для Каждого Элемент Из Источник Цикл
		Приемник.Добавить(Элемент);
	КонецЦикла;

КонецПроцедуры

Функция ОктетыИзГрупп(Группы)

	Октеты = Новый Массив;
	Для Каждого Группа Из Группы Цикл
		СтаршийОктет = Цел(Группа / 256);
		Октеты.Добавить(СтаршийОктет);
		Октеты.Добавить(Группа - СтаршийОктет * 256);
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Октеты);

КонецФункции

Функция ЗонаДопустимаДляАдреса(Октеты)

	ЭтоЛокальныйДляКанала = Октеты[0] = 254
		И Октеты[1] >= 128
		И Октеты[1] <= 191;

	Если ЭтоЛокальныйДляКанала Тогда
		Возврат Истина;
	КонецЕсли;

	Если Октеты[0] <> 255 Тогда
		Возврат Ложь;
	КонецЕсли;

	ОбластьГрупповогоАдреса = Октеты[1] - Цел(Октеты[1] / 16) * 16;

	Возврат ОбластьГрупповогоАдреса >= 1 И ОбластьГрупповогоАдреса <= 13;

КонецФункции

Функция ЗонаДопустима(Зона)

	Если СтрДлина(Зона) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Зона) Цикл
		Символ = Сред(Зона, Позиция, 1);
		Если Символ = "%"
			Или Символ = "["
			Или Символ = "]"
			Или Символ = Символы.ВК
			Или Символ = Символы.ПС
			Или КодСимвола(Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура ВызватьОшибкуРазбора(Причина = Неопределено)

	ВызватьИсключение ФабрикаОшибокIP.Создать(
		КодыОшибокIP.НедопустимыйIPv6(),
		"Недопустимое представление IPv6-адреса",
		"Адрес",
		"IPv6 по RFC 4291",
		Причина
	);

КонецПроцедуры

Процедура ВызватьОшибкуНедопустимойЗоны()

	ВызватьИсключение ФабрикаОшибокIP.Создать(
		КодыОшибокIP.НедопустимаяЗона(),
		"Недопустимая зона IPv6-адреса",
		"Зона",
		"непустой идентификатор зоны допустимой области"
	);

КонецПроцедуры

#КонецОбласти
