#Использовать errors
#Использовать "../internal"

Перем _Адрес; // IPАдрес
Перем _Порт; // Число
Перем _Строка; // Строка, Неопределено

#Область ОбработчикиСобытий

// Создаёт неизменяемую IP-конечную точку из строки, другой конечной точки или IP-адреса и порта.
//
// Параметры:
//  Значение - Строка, IPАдрес, IPКонечнаяТочка - Исходное представление конечной точки.
//  Порт - Число, Неопределено - Числовой порт от 0 до 65535.
//
// Исключения:
//  argument.invalid_type - Передана недопустимая комбинация аргументов.
//  argument.required - Для IPАдрес не передан порт.
//  argument.invalid_value - Числовой порт не является целым числом.
//  argument.out_of_range - Целый числовой порт находится вне диапазона от 0 до 65535.
//  ip.invalid_endpoint - Строка не соответствует формату IP-конечной точки.
//  ip.port_out_of_range - Текстовый порт находится вне диапазона от 0 до 65535.
Процедура ПриСозданииОбъекта(Значение, Порт = Неопределено)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") И Порт = Неопределено Тогда
		ДанныеКонечнойТочки = ДанныеКонечнойТочкиИзСтроки(Значение);
		УстановитьСостояние(ДанныеКонечнойТочки.Адрес, ДанныеКонечнойТочки.Порт);
		Возврат;
	КонецЕсли;

	Если ТипЗначения = Тип("IPКонечнаяТочка") И Порт = Неопределено Тогда
		УстановитьСостояние(Значение.Адрес(), Значение.Порт());
		Возврат;
	КонецЕсли;

	Если ТипЗначения = Тип("IPАдрес") Тогда
		Если Порт = Неопределено Тогда
			ВызватьИсключение СтандартныеОшибки.АргументНеЗаполнен("Порт");
		КонецЕсли;

		УстановитьСостояние(Значение, ПроверитьЧисловойПорт(Порт));
		Возврат;
	КонецЕсли;

	Если ТипЗначения = Тип("Строка") Тогда
		УстановитьСостояние(Новый IPАдрес(Значение), ПроверитьЧисловойПорт(Порт));
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
		"Значение",
		"Строка, IPАдрес или IPКонечнаяТочка",
		Значение
	);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает IP-адрес конечной точки.
//
// Возвращаемое значение:
//  IPАдрес - Неизменяемый IP-адрес, включая зону IPv6.
Функция Адрес() Экспорт

	Возврат Новый IPАдрес(_Адрес);

КонецФункции

// Возвращает числовой порт конечной точки.
//
// Возвращаемое значение:
//  Число - Целое число от 0 до 65535.
Функция Порт() Экспорт

	Возврат _Порт;

КонецФункции

// Возвращает каноническое текстовое представление конечной точки.
//
// Возвращаемое значение:
//  Строка - IPv4-адрес с портом или IPv6-адрес, включая зону, в квадратных скобках с портом.
Функция ВСтроку() Экспорт

	Если _Строка = Неопределено Тогда
		Если _Адрес.ЭтоIPv6() Тогда
			_Строка = "[" + _Адрес.ВСтроку() + "]:" + Строка(_Порт);
		Иначе
			_Строка = _Адрес.ВСтроку() + ":" + Строка(_Порт);
		КонецЕсли;
	КонецЕсли;

	Возврат _Строка;

КонецФункции

// Проверяет равенство конечной точки другой конечной точке.
//
// Параметры:
//  Другая - IPКонечнаяТочка - Сравниваемая конечная точка.
//
// Возвращаемое значение:
//  Булево - Истина, если адреса, включая зоны, и порты равны.
Функция Равно(Другая) Экспорт

	Если ТипЗнч(Другая) <> Тип("IPКонечнаяТочка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ВСтроку() = Другая.ВСтроку();

КонецФункции

// Сравнивает конечную точку с другой сначала по адресу, затем по числовому порту.
//
// Параметры:
//  Другая - IPКонечнаяТочка - Сравниваемая конечная точка.
//
// Возвращаемое значение:
//  Число - -1, если текущая конечная точка меньше другой; 0 при равенстве; иначе 1.
//
// Исключения:
//  argument.invalid_type - Другая имеет недопустимый тип.
Функция Сравнить(Другая) Экспорт

	ПроверкаАргументов.ПроверитьТип("Другая", Другая, Тип("IPКонечнаяТочка"));

	Если ВСтроку() = Другая.ВСтроку() Тогда
		Возврат 0;
	КонецЕсли;

	РезультатСравненияАдресов = _Адрес.Сравнить(Другая.Адрес());
	Если РезультатСравненияАдресов <> 0 Тогда
		Возврат РезультатСравненияАдресов;
	КонецЕсли;

	Если _Порт < Другая.Порт() Тогда
		Возврат -1;
	ИначеЕсли _Порт > Другая.Порт() Тогда
		Возврат 1;
	КонецЕсли;

	Возврат 0;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеКонечнойТочкиИзСтроки(Значение)

	Если ПустаяСтрока(Значение) Тогда
		ВызватьОшибкуНедопустимойКонечнойТочки();
	КонецЕсли;

	Если Лев(Значение, 1) = "[" Тогда
		Возврат ДанныеКонечнойТочкиИзСтрокиIPv6(Значение);
	КонецЕсли;

	Возврат ДанныеКонечнойТочкиИзСтрокиIPv4(Значение);

КонецФункции

Функция ДанныеКонечнойТочкиИзСтрокиIPv4(Значение)

	ПозицияРазделителя = СтрНайти(Значение, ":");
	Если ПозицияРазделителя <= 1 Тогда
		ВызватьОшибкуНедопустимойКонечнойТочки();
	КонецЕсли;

	ХвостПослеРазделителя = Сред(Значение, ПозицияРазделителя + 1);
	ПозицияЛишнегоРазделителя = СтрНайти(ХвостПослеРазделителя, ":");
	Если ПозицияЛишнегоРазделителя > 0 Тогда
		ВызватьОшибкуНедопустимойКонечнойТочки();
	КонецЕсли;

	СтрокаАдреса = Лев(Значение, ПозицияРазделителя - 1);
	СтрокаПорта = Сред(Значение, ПозицияРазделителя + 1);
	Адрес = РазобратьIPv4ДляКонечнойТочки(СтрокаАдреса);

	Возврат Новый Структура(
		"Адрес,Порт",
		Адрес,
		РазобратьТекстовыйПорт(СтрокаПорта)
	);

КонецФункции

Функция ДанныеКонечнойТочкиИзСтрокиIPv6(Значение)

	ПозицияЗакрывающейСкобки = СтрНайти(Значение, "]");
	Если ПозицияЗакрывающейСкобки <= 2 Тогда
		ВызватьОшибкуНедопустимойКонечнойТочки();
	КонецЕсли;

	ХвостПослеСкобки = Сред(Значение, ПозицияЗакрывающейСкобки + 1);
	ПозицияЛишнейСкобки = СтрНайти(ХвостПослеСкобки, "]");
	Если ПозицияЛишнейСкобки > 0 Тогда
		ВызватьОшибкуНедопустимойКонечнойТочки();
	КонецЕсли;

	Если Сред(Значение, ПозицияЗакрывающейСкобки + 1, 1) <> ":" Тогда
		ВызватьОшибкуНедопустимойКонечнойТочки();
	КонецЕсли;

	СтрокаАдреса = Сред(Значение, 2, ПозицияЗакрывающейСкобки - 2);
	СтрокаПорта = Сред(Значение, ПозицияЗакрывающейСкобки + 2);
	Адрес = РазобратьIPv6ДляКонечнойТочки(СтрокаАдреса);

	Возврат Новый Структура(
		"Адрес,Порт",
		Адрес,
		РазобратьТекстовыйПорт(СтрокаПорта)
	);

КонецФункции

Функция РазобратьIPv4ДляКонечнойТочки(СтрокаАдреса)

	Попытка
		Адрес = Новый IPАдрес(СтрокаАдреса);
	Исключение
		Причина = ИнформацияОбОшибке();
		ВызватьОшибкуНедопустимойКонечнойТочки(
			Причина,
			"Адрес",
			"IPv4"
		);
	КонецПопытки;

	Если Не Адрес.ЭтоIPv4() Тогда
		ВызватьОшибкуНедопустимойКонечнойТочки();
	КонецЕсли;

	Возврат Адрес;

КонецФункции

Функция РазобратьIPv6ДляКонечнойТочки(СтрокаАдреса)

	Попытка
		Адрес = Новый IPАдрес(СтрокаАдреса);
	Исключение
		Причина = ИнформацияОбОшибке();
		ВызватьОшибкуНедопустимойКонечнойТочки(
			Причина,
			"Адрес",
			"IPv6"
		);
	КонецПопытки;

	Если Не Адрес.ЭтоIPv6() Тогда
		ВызватьОшибкуНедопустимойКонечнойТочки();
	КонецЕсли;

	Возврат Адрес;

КонецФункции

Функция РазобратьТекстовыйПорт(СтрокаПорта)

	Если ПустаяСтрока(СтрокаПорта) Тогда
		ВызватьОшибкуНедопустимойКонечнойТочки(
			Неопределено,
			"Порт",
			"десятичный порт от 0 до 65535"
		);
	КонецЕсли;

	Порт = 0;
	Для Позиция = 1 По СтрДлина(СтрокаПорта) Цикл
		Код = КодСимвола(СтрокаПорта, Позиция);
		Если Код < 48 Или Код > 57 Тогда
			ВызватьОшибкуНедопустимойКонечнойТочки(
				Неопределено,
				"Порт",
				"десятичный порт от 0 до 65535"
			);
		КонецЕсли;

		Порт = Порт * 10 + Код - 48;
		Если Порт > 65535 Тогда
			ВызватьОшибкуПортаВнеДиапазона();
		КонецЕсли;
	КонецЦикла;

	Возврат Порт;

КонецФункции

Функция ПроверитьЧисловойПорт(Порт)

	Если ТипЗнч(Порт) <> Тип("Число") Тогда
		ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента("Порт", "Число", Порт);
	КонецЕсли;

	Если Порт <> Цел(Порт) Тогда
		ВызватьИсключение СтандартныеОшибки.НедопустимоеЗначениеАргумента(
			"Порт",
			"целое число"
		);
	КонецЕсли;

	Если Порт < 0 Или Порт > 65535 Тогда
		ВызватьИсключение СтандартныеОшибки.АргументВнеДиапазона(
			"Порт",
			"от 0 до 65535 включительно"
		);
	КонецЕсли;

	Возврат Порт;

КонецФункции

Процедура УстановитьСостояние(Адрес, Порт)

	_Адрес = Адрес;
	_Порт = Порт;
	_Строка = Неопределено;

КонецПроцедуры

Процедура ВызватьОшибкуНедопустимойКонечнойТочки(
	Причина = Неопределено,
	Компонент = "КонечнаяТочка",
	Ожидание = "IPv4:порт или [IPv6]:порт"
)

	ВызватьИсключение ФабрикаОшибокIP.Создать(
		КодыОшибокIP.НедопустимаяКонечнаяТочка(),
		"Строка не соответствует строгому формату IP-конечной точки",
		Компонент,
		Ожидание,
		Причина
	);

КонецПроцедуры

Процедура ВызватьОшибкуПортаВнеДиапазона()

	ВызватьИсключение ФабрикаОшибокIP.Создать(
		КодыОшибокIP.ПортВнеДиапазона(),
		"Порт конечной точки находится вне диапазона от 0 до 65535",
		"Порт",
		"десятичный порт от 0 до 65535"
	);

КонецПроцедуры

#КонецОбласти
