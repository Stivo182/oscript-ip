#Использовать errors
#Использовать "../internal"

Перем _БазовыйАдрес; // IPАдрес
Перем _ДлинаПрефикса; // Число

#Область ОбработчикиСобытий

// Создаёт неизменяемый IP-префикс из строки CIDR, другого префикса или базового IP-адреса и длины.
//
// Ссылки:
//  RFC 4632, раздел 3.1 - бесклассовая адресация IPv4 и запись CIDR:
//  https://www.rfc-editor.org/rfc/rfc4632.html#section-3.1
//  RFC 4291, раздел 2.3 - текстовая запись префиксов IPv6:
//  https://www.rfc-editor.org/rfc/rfc4291.html#section-2.3
//
// Параметры:
//  Значение - Строка, IPПрефикс, IPАдрес - Исходное представление префикса.
//  ДлинаПрефикса - Число, Неопределено - Длина для строгого конструктора с IPАдресом.
//
// Исключения:
//  argument.invalid_type - Передана недопустимая комбинация аргументов.
//  argument.required - Для IPАдрес не передана длина префикса.
//  argument.invalid_value - ДлинаПрефикса не является целым числом.
//  argument.out_of_range - Числовая ДлинаПрефикса для IPАдреса вне диапазона семейства.
//  ip.invalid_prefix - Строка не соответствует строгому формату префикса.
//  ip.prefix_length_out_of_range - Длина в строковом CIDR вне диапазона семейства адреса.
//  ip.prefix.host_bits_set - В базовом адресе установлены биты узла.
Процедура ПриСозданииОбъекта(Значение, ДлинаПрефикса = Неопределено)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") И ДлинаПрефикса = Неопределено Тогда
		ДанныеПрефикса = ДанныеПрефиксаИзСтроки(Значение);
		УстановитьСостояние(ДанныеПрефикса.БазовыйАдрес, ДанныеПрефикса.ДлинаПрефикса, Истина);
		Возврат;
	КонецЕсли;

	Если ТипЗначения = Тип("IPПрефикс") И ДлинаПрефикса = Неопределено Тогда
		УстановитьСостояние(Значение.БазовыйАдрес(), Значение.ДлинаПрефикса());
		Возврат;
	КонецЕсли;

	Если ТипЗначения = Тип("IPАдрес") И ДлинаПрефикса <> Неопределено Тогда
		УстановитьСостояние(Значение, ДлинаПрефикса);
		Возврат;
	КонецЕсли;

	Если ТипЗначения = Тип("IPАдрес") Тогда
		ВызватьИсключение СтандартныеОшибки.АргументНеЗаполнен("ДлинаПрефикса");
	КонецЕсли;

	ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
		"Значение",
		"Строка, IPПрефикс или IPАдрес с длиной префикса",
		Значение
	);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает версию IP-адресов префикса.
//
// Возвращаемое значение:
//  Число - 4 для IPv4 или 6 для IPv6.
Функция Версия() Экспорт

	Возврат _БазовыйАдрес.Версия();

КонецФункции

// Проверяет принадлежность префикса к IPv4.
//
// Возвращаемое значение:
//  Булево - Истина, если префикс относится к IPv4.
Функция ЭтоIPv4() Экспорт

	Возврат _БазовыйАдрес.ЭтоIPv4();

КонецФункции

// Проверяет принадлежность префикса к IPv6.
//
// Возвращаемое значение:
//  Булево - Истина, если префикс относится к IPv6.
Функция ЭтоIPv6() Экспорт

	Возврат _БазовыйАдрес.ЭтоIPv6();

КонецФункции

// Возвращает длину адресов префикса в битах.
//
// Возвращаемое значение:
//  Число - 32 для IPv4 или 128 для IPv6.
Функция ДлинаАдресаВБитах() Экспорт

	Возврат _БазовыйАдрес.ДлинаВБитах();

КонецФункции

// Возвращает длину префикса.
//
// Возвращаемое значение:
//  Число - Количество сетевых старших битов.
Функция ДлинаПрефикса() Экспорт

	Возврат _ДлинаПрефикса;

КонецФункции

// Возвращает базовый адрес префикса без зоны.
//
// Возвращаемое значение:
//  IPАдрес - Адрес с нулевыми битами узла.
Функция БазовыйАдрес() Экспорт

	Возврат Новый IPАдрес(_БазовыйАдрес);

КонецФункции

// Возвращает маску префикса.
//
// Возвращаемое значение:
//  IPАдрес - Адрес с единицами в сетевых битах и нулями в битах узла.
Функция Маска() Экспорт

	Октеты = Новый Массив;
	Для Индекс = 1 По _БазовыйАдрес.Октеты().Количество() Цикл
		Октеты.Добавить(255);
	КонецЦикла;

	Возврат Новый IPАдрес(IPБиты.ПрименитьМаску(Октеты, _ДлинаПрефикса));

КонецФункции

// Возвращает первый адрес диапазона префикса.
//
// Возвращаемое значение:
//  IPАдрес - Базовый адрес префикса.
Функция ПервыйАдрес() Экспорт

	Возврат БазовыйАдрес();

КонецФункции

// Возвращает последний адрес диапазона префикса.
//
// Возвращаемое значение:
//  IPАдрес - Адрес с единицами во всех битах узла.
Функция ПоследнийАдрес() Экспорт

	БазовыеОктеты = _БазовыйАдрес.Октеты();
	ОктетыМаски = Маска().Октеты();
	ОктетыПоследнегоАдреса = Новый Массив;
	Для Индекс = 0 По БазовыеОктеты.Количество() - 1 Цикл
		ОктетыПоследнегоАдреса.Добавить(БазовыеОктеты[Индекс] + 255 - ОктетыМаски[Индекс]);
	КонецЦикла;

	Возврат Новый IPАдрес(ОктетыПоследнегоАдреса);

КонецФункции

// Возвращает каноническое текстовое представление префикса.
//
// Возвращаемое значение:
//  Строка - Канонический IP-адрес без зоны, символ / и длина префикса.
Функция ВСтроку() Экспорт

	Возврат _БазовыйАдрес.ВСтроку() + "/" + Строка(_ДлинаПрефикса);

КонецФункции

// Проверяет принадлежность IP-адреса префиксу без учёта зоны IPv6.
//
// Параметры:
//  Адрес - IPАдрес - Проверяемый IP-адрес.
//
// Возвращаемое значение:
//  Булево - Истина, если семейство и первые биты адреса соответствуют префиксу.
//
// Исключения:
//  argument.invalid_type - Адрес имеет недопустимый тип.
Функция Содержит(Адрес) Экспорт

	ПроверкаАргументов.ПроверитьТип("Адрес", Адрес, Тип("IPАдрес"));

	Если Версия() <> Адрес.Версия() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СовпадаютСтаршиеБиты(_БазовыйАдрес.Октеты(), Адрес.Октеты(), _ДлинаПрефикса);

КонецФункции

// Проверяет, имеют ли два префикса хотя бы один общий IP-адрес.
//
// Параметры:
//  Другой - IPПрефикс - Сравниваемый префикс.
//
// Возвращаемое значение:
//  Булево - Истина, если семейство и первые общие биты префиксов совпадают.
//
// Исключения:
//  argument.invalid_type - Другой имеет недопустимый тип.
Функция Пересекается(Другой) Экспорт

	ПроверкаАргументов.ПроверитьТип("Другой", Другой, Тип("IPПрефикс"));

	Если Версия() <> Другой.Версия() Тогда
		Возврат Ложь;
	КонецЕсли;

	ДлинаСравнения = _ДлинаПрефикса;
	Если Другой.ДлинаПрефикса() < ДлинаСравнения Тогда
		ДлинаСравнения = Другой.ДлинаПрефикса();
	КонецЕсли;

	Возврат СовпадаютСтаршиеБиты(
		_БазовыйАдрес.Октеты(),
		Другой.БазовыйАдрес().Октеты(),
		ДлинаСравнения
	);

КонецФункции

// Проверяет, состоит ли префикс ровно из одного адреса.
//
// Возвращаемое значение:
//  Булево - Истина для IPv4 /32 или IPv6 /128.
Функция СостоитИзОдногоАдреса() Экспорт

	Возврат _ДлинаПрефикса = ДлинаАдресаВБитах();

КонецФункции

// Проверяет два префикса на равенство.
//
// Параметры:
//  Другой - IPПрефикс - Сравниваемый префикс.
//
// Возвращаемое значение:
//  Булево - Истина, если совпадают семейство, базовые октеты и длина префикса.
//
// Исключения:
//  argument.invalid_type - Другой имеет недопустимый тип.
Функция Равно(Другой) Экспорт

	ПроверкаАргументов.ПроверитьТип("Другой", Другой, Тип("IPПрефикс"));

	Возврат Версия() = Другой.Версия()
		И _ДлинаПрефикса = Другой.ДлинаПрефикса()
		И IPБиты.Сравнить(_БазовыйАдрес.Октеты(), Другой.БазовыйАдрес().Октеты()) = 0;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СовпадаютСтаршиеБиты(Первый, Второй, Длина)

	МаскированныйПервый = IPБиты.ПрименитьМаску(Первый, Длина);
	МаскированныйВторой = IPБиты.ПрименитьМаску(Второй, Длина);

	Возврат IPБиты.Сравнить(МаскированныйПервый, МаскированныйВторой) = 0;

КонецФункции

Функция ДанныеПрефиксаИзСтроки(Значение)

	ПозицияРазделителя = СтрНайти(Значение, "/");
	СтрокаАдреса = Лев(Значение, ПозицияРазделителя - 1);
	СтрокаДлины = Сред(Значение, ПозицияРазделителя + 1);
	ХвостПослеРазделителя = Сред(Значение, ПозицияРазделителя + 1);
	ЕстьВторойРазделитель = ПозицияРазделителя > 0
		И СтрНайти(ХвостПослеРазделителя, "/") > 0;

	Если ПозицияРазделителя = 0
		Или ЕстьВторойРазделитель
		Или ПустаяСтрока(СтрокаАдреса)
		Или ПустаяСтрока(СтрокаДлины) Тогда
		ВызватьОшибкуНедопустимогоПрефикса();
	КонецЕсли;

	Адрес = Новый IPАдрес(СтрокаАдреса);
	Если Адрес.ИмеетЗону() Тогда
		ВызватьОшибкуНедопустимогоПрефикса();
	КонецЕсли;

	ДлинаПрефикса = РазобратьДлинуПрефикса(СтрокаДлины);

	Возврат Новый Структура("БазовыйАдрес,ДлинаПрефикса", Адрес, ДлинаПрефикса);

КонецФункции

Функция РазобратьДлинуПрефикса(СтрокаДлины)

	Если СтрДлина(СтрокаДлины) > 1 И Лев(СтрокаДлины, 1) = "0" Тогда
		ВызватьОшибкуНедопустимогоПрефикса();
	КонецЕсли;

	Результат = 0;
	ДлинаВнеДиапазона = Ложь;
	Для Позиция = 1 По СтрДлина(СтрокаДлины) Цикл
		Код = КодСимвола(СтрокаДлины, Позиция);
		Если Код < 48 Или Код > 57 Тогда
			ВызватьОшибкуНедопустимогоПрефикса();
		КонецЕсли;

		Если Не ДлинаВнеДиапазона Тогда
			Результат = Результат * 10 + Код - 48;
			ДлинаВнеДиапазона = Результат > 128;
		КонецЕсли;
	КонецЦикла;

	Если ДлинаВнеДиапазона Тогда
		Возврат 129;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура УстановитьСостояние(БазовыйАдрес, ДлинаПрефикса, ТекстовыйРазбор = Ложь)

	ПроверитьДлинуПрефикса(ДлинаПрефикса, БазовыйАдрес.ДлинаВБитах(), ТекстовыйРазбор);
	Если БазовыйАдрес.ИмеетЗону() Тогда
		ВызватьОшибкуНедопустимогоПрефикса();
	КонецЕсли;

	Если Не IPБиты.БитыХостаРавныНулю(БазовыйАдрес.Октеты(), ДлинаПрефикса) Тогда
		ВызватьИсключение ОшибкиIP.Создать(
			КодыОшибокIP.УстановленыБитыУзла(),
			"В базовом адресе префикса установлены биты узла",
			"БазовыйАдрес"
		);
	КонецЕсли;

	_БазовыйАдрес = Новый IPАдрес(БазовыйАдрес.КопияБезЗоны());
	_ДлинаПрефикса = ДлинаПрефикса;

КонецПроцедуры

Процедура ПроверитьДлинуПрефикса(ДлинаПрефикса, ДлинаВБитах, ТекстовыйРазбор = Ложь)

	Если ТипЗнч(ДлинаПрефикса) <> Тип("Число") Тогда
		ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
			"ДлинаПрефикса",
			"Число",
			ДлинаПрефикса
		);
	КонецЕсли;

	Если ДлинаПрефикса <> Цел(ДлинаПрефикса) Тогда
		ВызватьИсключение СтандартныеОшибки.НедопустимоеЗначениеАргумента(
			"ДлинаПрефикса",
			"целое число"
		);
	КонецЕсли;

	Если ДлинаПрефикса < 0 Или ДлинаПрефикса > ДлинаВБитах Тогда
		Если ТекстовыйРазбор Тогда
			ВызватьИсключение ОшибкиIP.Создать(
				КодыОшибокIP.ДлинаПрефиксаВнеДиапазона(),
				"Длина префикса не соответствует семейству IP-адреса",
				"ДлинаПрефикса"
			);
		КонецЕсли;

		ВызватьИсключение СтандартныеОшибки.АргументВнеДиапазона(
			"ДлинаПрефикса",
			"от 0 до " + Строка(ДлинаВБитах) + " включительно"
		);
	КонецЕсли;

КонецПроцедуры

Процедура ВызватьОшибкуНедопустимогоПрефикса()

	ВызватьИсключение ОшибкиIP.Создать(
		КодыОшибокIP.НедопустимыйПрефикс(),
		"Строка не является строгим IP-префиксом",
		"Префикс"
	);

КонецПроцедуры

#КонецОбласти
