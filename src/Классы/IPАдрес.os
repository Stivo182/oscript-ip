#Использовать errors
#Использовать "../internal"

Перем _Состояние; // СостояниеIPАдреса

#Область ОбработчикиСобытий

// Создаёт неизменяемый IP-адрес из строки, другого адреса, двоичных данных или последовательности октетов.
// Зона допустима только для локального для канала или группового IPv6-адреса неглобальной области.
//
// Ссылки:
//  RFC 4291, раздел 2.2 - текстовое представление IPv6:
//  https://www.rfc-editor.org/rfc/rfc4291.html#section-2.2
//  RFC 4007, раздел 11 - идентификаторы зон IPv6:
//  https://www.rfc-editor.org/rfc/rfc4007.html#section-11
//
// Параметры:
//  Значение - Строка, IPАдрес, ДвоичныеДанные, Массив, ФиксированныйМассив - Исходное представление адреса.
//
// Исключения:
//  argument.invalid_type - Значение или октет имеет недопустимый тип.
//  argument.invalid_value - Октет не является целым числом.
//  argument.out_of_range - Октет находится вне диапазона от 0 до 255.
//  ip.invalid_address - Строка не является IP-адресом.
//  ip.invalid_ipv4 - Строка не соответствует строгому формату IPv4.
//  ip.invalid_ipv6 - Строка не соответствует формату IPv6 RFC 4291.
//  ip.invalid_zone - Зона IPv6 не соответствует профилю библиотеки или области адреса.
//  ip.zone_not_allowed_for_ipv4 - Для IPv4 передана зона.
//  ip.invalid_byte_length - Передано не 4 и не 16 октетов.
Процедура ПриСозданииОбъекта(Значение)

	ДанныеАдреса = ДанныеАдресаИзЗначения(Значение);
	ПроверитьОктеты(ДанныеАдреса.Октеты);
	Октеты = ДанныеАдреса.Октеты;
	_Состояние = Новый СостояниеIPАдреса(Октеты, ДанныеАдреса.Зона);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает версию IP-адреса.
//
// Возвращаемое значение:
//  Число - 4 для IPv4 или 6 для IPv6.
Функция Версия() Экспорт

	Возврат _Состояние.Версия();

КонецФункции

// Проверяет принадлежность адреса к IPv4.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес относится к IPv4.
Функция ЭтоIPv4() Экспорт

	Возврат _Состояние.ЭтоIPv4();

КонецФункции

// Проверяет принадлежность адреса к IPv6.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес относится к IPv6.
Функция ЭтоIPv6() Экспорт

	Возврат _Состояние.ЭтоIPv6();

КонецФункции

// Возвращает длину адреса в битах.
//
// Возвращаемое значение:
//  Число - 32 для IPv4 или 128 для IPv6.
Функция ДлинаВБитах() Экспорт

	Возврат _Состояние.ДлинаВБитах();

КонецФункции

// Возвращает каноническое текстовое представление IP-адреса.
//
// Ссылки:
//  RFC 5952, раздел 4 - каноническая текстовая запись IPv6:
//  https://www.rfc-editor.org/rfc/rfc5952.html#section-4
//
// Возвращаемое значение:
//  Строка - IPv4 или IPv6 по RFC 5952; при наличии зоны IPv6 добавляется суффикс %зона.
Функция ВСтроку() Экспорт

	СтрокаБезЗоны = СтрокаБезЗоны();
	Если ЕстьЗона() Тогда
		Возврат СтрокаБезЗоны + "%" + Зона();
	КонецЕсли;

	Возврат СтрокаБезЗоны;

КонецФункции

// Возвращает каноническое текстовое представление IP-адреса без зоны IPv6.
//
// Возвращаемое значение:
//  Строка - Каноническое текстовое представление IP-адреса без суффикса зоны.
Функция СтрокаБезЗоны() Экспорт

	Октеты = _Состояние.Октеты();

	Если ЭтоIPv6() Тогда
		Возврат Новый СериализаторIPv6(Октеты).ВСтроку();
	КонецЕсли;

	Возврат Строка(Октеты[0]) + "."
		+ Строка(Октеты[1]) + "."
		+ Строка(Октеты[2]) + "."
		+ Строка(Октеты[3]);

КонецФункции

// Возвращает развёрнутое текстовое представление IP-адреса.
//
// Возвращаемое значение:
//  Строка - IPv4 в точечно-десятичной записи или IPv6 из восьми четырёхзначных шестнадцатеричных групп.
//    Зона IPv6 сохраняется.
Функция РазвернутаяСтрока() Экспорт

	Если ЭтоIPv4() Тогда
		Возврат ВСтроку();
	КонецЕсли;

	Результат = Новый СериализаторIPv6(_Состояние.Октеты()).РазвернутаяСтрока();
	Если ЕстьЗона() Тогда
		Результат = Результат + "%" + Зона();
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает двоичное представление адреса в сетевом порядке байтов.
//
// Возвращаемое значение:
//  ДвоичныеДанные - Четыре байта для IPv4 или шестнадцать байтов для IPv6.
Функция Байты() Экспорт

	Возврат _Состояние.Байты();

КонецФункции

// Возвращает новую неизменяемую коллекцию октетов адреса.
//
// Возвращаемое значение:
//  ФиксированныйМассив - Новая неизменяемая последовательность из 4 или 16 октетов.
Функция Октеты() Экспорт

	Возврат _Состояние.Октеты();

КонецФункции

// Проверяет наличие зоны IPv6-адреса.
//
// Возвращаемое значение:
//  Булево - Истина, если у IPv6-адреса задана зона.
Функция ЕстьЗона() Экспорт

	Возврат _Состояние.ЕстьЗона();

КонецФункции

// Возвращает зону IPv6-адреса.
//
// Возвращаемое значение:
//  Строка, Неопределено - Зона IPv6-адреса или Неопределено.
Функция Зона() Экспорт

	Возврат _Состояние.Зона();

КонецФункции

// Возвращает новый IPv6-адрес ограниченной области с указанной зоной.
//
// Ссылки:
//  RFC 4007, раздел 11 - идентификаторы зон IPv6:
//  https://www.rfc-editor.org/rfc/rfc4007.html#section-11
//  RFC 9844, раздел 5 - синтаксис идентификатора зоны:
//  https://www.rfc-editor.org/rfc/rfc9844.html#section-5
//
// Параметры:
//  Зона - Строка - Непустая зона IPv6-адреса.
//
// Возвращаемое значение:
//  IPАдрес - Новый IPv6-адрес с теми же 128 битами и заданной зоной.
//
// Исключения:
//  argument.invalid_type - Зона имеет недопустимый тип.
//  ip.invalid_zone - Зона не соответствует профилю библиотеки или области адреса.
//  ip.zone_not_allowed_for_ipv4 - Адрес относится к IPv4.
Функция СЗоной(Зона) Экспорт

	Если ЭтоIPv4() Тогда
		ВызватьОшибкуЗоныДляIPv4();
	КонецЕсли;

	ПроверитьЗону(Зона);

	Возврат СоздатьАдресСЗоной(Зона);

КонецФункции

// Возвращает новый IP-адрес без зоны.
//
// Возвращаемое значение:
//  IPАдрес - Новый IP-адрес с теми же битами без зоны.
Функция БезЗоны() Экспорт

	Возврат СоздатьАдресСЗоной(Неопределено);

КонецФункции

// Проверяет, является ли адрес незаданным.
//
// Ссылки:
//  RFC 1122, раздел 3.2.1.3 - незаданный адрес IPv4:
//  https://www.rfc-editor.org/rfc/rfc1122.html#section-3.2.1.3
//  RFC 4291, раздел 2.5.2 - незаданный адрес IPv6:
//  https://www.rfc-editor.org/rfc/rfc4291.html#section-2.5.2
//
// Возвращаемое значение:
//  Булево - Истина для IPv4 0.0.0.0 или IPv6 ::.
Функция ЭтоНезаданный() Экспорт

	Возврат IPКлассификация.ЭтоНезаданный(_Состояние.Октеты());

КонецФункции

// Проверяет, является ли адрес петлевым по RFC 1122 и RFC 4291.
//
// Ссылки:
//  RFC 1122, раздел 3.2.1.3 - петлевые адреса IPv4:
//  https://www.rfc-editor.org/rfc/rfc1122.html#section-3.2.1.3
//  RFC 4291, раздел 2.5.3 - петлевой адрес IPv6:
//  https://www.rfc-editor.org/rfc/rfc4291.html#section-2.5.3
//
// Возвращаемое значение:
//  Булево - Истина для IPv4 127.0.0.0/8 или IPv6 ::1.
Функция ЭтоПетлевой() Экспорт

	Возврат IPКлассификация.ЭтоПетлевой(_Состояние.Октеты());

КонецФункции

// Проверяет, является ли адрес локальным для канала по RFC 3927 и RFC 4291.
//
// Ссылки:
//  RFC 3927, раздел 2.1 - локальные для канала адреса IPv4:
//  https://www.rfc-editor.org/rfc/rfc3927.html#section-2.1
//  RFC 4291, раздел 2.5.6 - локальные для канала адреса IPv6:
//  https://www.rfc-editor.org/rfc/rfc4291.html#section-2.5.6
//
// Возвращаемое значение:
//  Булево - Истина для IPv4 169.254.0.0/16 или IPv6 fe80::/10.
Функция ЭтоЛокальныйДляКанала() Экспорт

	Возврат IPКлассификация.ЭтоЛокальныйДляКанала(_Состояние.Октеты());

КонецФункции

// Проверяет, относится ли адрес к частному диапазону по RFC 1918 и RFC 4193.
//
// Ссылки:
//  RFC 1918, раздел 3 - частные диапазоны IPv4:
//  https://www.rfc-editor.org/rfc/rfc1918.html#section-3
//  RFC 4193, раздел 3.1 - уникальные локальные адреса IPv6:
//  https://www.rfc-editor.org/rfc/rfc4193.html#section-3.1
//
// Возвращаемое значение:
//  Булево - Истина для частных IPv4-диапазонов или IPv6 fc00::/7.
Функция ЭтоЧастный() Экспорт

	Возврат IPКлассификация.ЭтоЧастный(_Состояние.Октеты());

КонецФункции

// Проверяет, является ли адрес групповым по RFC 1112 и RFC 4291.
//
// Ссылки:
//  RFC 1112, раздел 4 - групповые адреса IPv4:
//  https://www.rfc-editor.org/rfc/rfc1112.html#section-4
//  RFC 4291, раздел 2.7 - групповые адреса IPv6:
//  https://www.rfc-editor.org/rfc/rfc4291.html#section-2.7
//
// Возвращаемое значение:
//  Булево - Истина для IPv4 224.0.0.0/4 или IPv6 ff00::/8.
Функция ЭтоГрупповой() Экспорт

	Возврат IPКлассификация.ЭтоГрупповой(_Состояние.Октеты());

КонецФункции

// Проверяет, предназначен ли адрес для документации по RFC 5737 и RFC 3849.
//
// Ссылки:
//  RFC 5737, раздел 3 - диапазоны IPv4 для документации:
//  https://www.rfc-editor.org/rfc/rfc5737.html#section-3
//  RFC 3849, раздел 2 - префикс IPv6 для документации:
//  https://www.rfc-editor.org/rfc/rfc3849.html#section-2
//
// Возвращаемое значение:
//  Булево - Истина для диапазонов IPv4, предназначенных для документации, или IPv6 2001:db8::/32.
Функция ЭтоДляДокументации() Экспорт

	Возврат IPКлассификация.ЭтоДляДокументации(_Состояние.Октеты());

КонецФункции

// Проверяет, что IPv6-адрес содержит отображённый IPv4 по RFC 4291.
//
// Ссылки:
//  RFC 4291, раздел 2.5.5.2 - IPv6-адрес с отображённым IPv4:
//  https://www.rfc-editor.org/rfc/rfc4291.html#section-2.5.5.2
//
// Возвращаемое значение:
//  Булево - Истина для IPv6 с 80 нулевыми битами и последующей группой ffff.
Функция ЭтоIPv6СОтображеннымIPv4() Экспорт

	Возврат ЭтоIPv6()
		И IPБиты.ЭтоIPv6СОтображеннымIPv4(_Состояние.Октеты());

КонецФункции

// Возвращает IPv6-представление IP-адреса.
//
// Возвращаемое значение:
//  IPАдрес - IPv6-адрес; IPv4 преобразуется в IPv6 с отображённым IPv4 без зоны.
Функция IPv6() Экспорт

	Если ЭтоIPv6() Тогда
		Возврат СоздатьАдресСЗоной(Зона());
	КонецЕсли;

	ОктетыIPv6 = Новый Массив;
	Для Индекс = 1 По 10 Цикл
		ОктетыIPv6.Добавить(0);
	КонецЦикла;
	ОктетыIPv6.Добавить(255);
	ОктетыIPv6.Добавить(255);

	Для Каждого Октет Из _Состояние.Октеты() Цикл
		ОктетыIPv6.Добавить(Октет);
	КонецЦикла;

	Возврат Новый IPАдрес(ОктетыIPv6);

КонецФункции

// Возвращает IPv4-представление IP-адреса, если оно существует.
//
// Возвращаемое значение:
//  IPАдрес, Неопределено - IPv4 или отображённый в IPv6 адрес IPv4; иначе Неопределено.
Функция IPv4() Экспорт

	Если ЭтоIPv4() Тогда
		Возврат Новый IPАдрес(_Состояние.Октеты());
	КонецЕсли;

	Если Не ЭтоIPv6СОтображеннымIPv4() Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОктетыIPv4 = Новый Массив;
	ОктетыIPv6 = _Состояние.Октеты();

	Для Индекс = 12 По 15 Цикл
		ОктетыIPv4.Добавить(ОктетыIPv6[Индекс]);
	КонецЦикла;

	Возврат Новый IPАдрес(ОктетыIPv4);

КонецФункции

// Создаёт канонический сетевой префикс указанной длины из текущего IP-адреса.
//
// Биты узла обнуляются, а зона IPv6 в префикс не переносится.
//
// Параметры:
//  ДлинаПрефикса - Число - Количество старших битов адреса: от 0 до 32 или от 0 до 128.
//
// Возвращаемое значение:
//  IPПрефикс - Канонический сетевой префикс без зоны.
//
// Исключения:
//  argument.invalid_type - ДлинаПрефикса имеет недопустимый тип.
//  argument.invalid_value - ДлинаПрефикса не является целым числом.
//  argument.out_of_range - ДлинаПрефикса не соответствует семейству адреса.
Функция Префикс(ДлинаПрефикса) Экспорт

	ПроверитьДлинуПрефикса(ДлинаПрефикса);
	МаскированныеОктеты = IPБиты.ПрименитьМаску(_Состояние.Октеты(), ДлинаПрефикса);

	Возврат Новый IPПрефикс(Новый IPАдрес(МаскированныеОктеты), ДлинаПрефикса);

КонецФункции

// Проверяет равенство IP-адреса другому адресу, включая состояние и строку зоны.
//
// Параметры:
//  Другой - IPАдрес - Сравниваемый адрес.
//
// Возвращаемое значение:
//  Булево - Истина, если версии, октеты, состояние зоны и строки зон равны.
//
// Исключения:
//  argument.invalid_type - Другой имеет недопустимый тип.
Функция Равно(Другой) Экспорт

	ПроверкаАргументов.ПроверитьТип("Другой", Другой, Тип("IPАдрес"));

	Возврат Сравнить(Другой) = 0;

КонецФункции

// Проверяет равенство IP-адреса другому адресу без учёта зон IPv6.
//
// Параметры:
//  Другой - IPАдрес - Сравниваемый адрес.
//
// Возвращаемое значение:
//  Булево - Истина, если версии и октеты равны.
//
// Исключения:
//  argument.invalid_type - Другой имеет недопустимый тип.
Функция РавноБезЗоны(Другой) Экспорт

	ПроверкаАргументов.ПроверитьТип("Другой", Другой, Тип("IPАдрес"));

	Возврат Версия() = Другой.Версия()
		И IPБиты.Сравнить(_Состояние.Октеты(), Другой.Октеты()) = 0;

КонецФункции

// Сравнивает IP-адрес с другим: сначала версию, затем сетевые байты, наличие и строку зоны.
//
// Параметры:
//  Другой - IPАдрес - Сравниваемый адрес.
//
// Возвращаемое значение:
//  Число - -1, если текущий адрес меньше другого; 0 при равенстве; иначе 1.
//
// Исключения:
//  argument.invalid_type - Другой имеет недопустимый тип.
Функция Сравнить(Другой) Экспорт

	ПроверкаАргументов.ПроверитьТип("Другой", Другой, Тип("IPАдрес"));

	Если Версия() < Другой.Версия() Тогда
		Возврат -1;
	ИначеЕсли Версия() > Другой.Версия() Тогда
		Возврат 1;
	КонецЕсли;

	РезультатСравненияОктетов = IPБиты.Сравнить(_Состояние.Октеты(), Другой.Октеты());
	Если РезультатСравненияОктетов <> 0 Тогда
		Возврат РезультатСравненияОктетов;
	КонецЕсли;

	ПерваяЗона = Зона();
	ВтораяЗона = Другой.Зона();
	Если ПерваяЗона = Неопределено Тогда
		Если ВтораяЗона = Неопределено Тогда
			Возврат 0;
		КонецЕсли;

		Возврат -1;
	ИначеЕсли ВтораяЗона = Неопределено Тогда
		Возврат 1;
	КонецЕсли;

	Возврат IPБиты.СравнитьСтрокиПоКодамСимволов(ПерваяЗона, ВтораяЗона);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьДанныеАдреса(Октеты, Зона)

	Возврат Новый Структура("Октеты,Зона", Октеты, Зона);

КонецФункции

Функция ДанныеАдресаИзЗначения(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат ДанныеАдресаИзСтроки(Значение);
	ИначеЕсли ТипЗначения = Тип("IPАдрес") Тогда
		Октеты = Значение.Октеты();
		Возврат СоздатьДанныеАдреса(Октеты, Значение.Зона());
	ИначеЕсли ТипЗначения = Тип("ДвоичныеДанные") Тогда
		Октеты = IPБиты.ИзДвоичныхДанных(Значение);
		Возврат СоздатьДанныеАдреса(Октеты, Неопределено);
	ИначеЕсли ТипЗначения = Тип("Массив")
		Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Возврат СоздатьДанныеАдреса(Значение, Неопределено);
	КонецЕсли;

	ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
		"Значение",
		"Строка, IPАдрес, ДвоичныеДанные, Массив или ФиксированныйМассив",
		Значение
	);

КонецФункции

Функция ДанныеАдресаИзСтроки(Значение)

	Если ПустаяСтрока(Значение) Тогда
		ВызватьОшибкуНедопустимогоАдреса();
	КонецЕсли;

	ПозицияЗоны = СтрНайти(Значение, "%");
	IPv4ДоЗоны = Лев(Значение, ПозицияЗоны - 1);
	Если ПозицияЗоны > 1 И ЭтоСтрогийIPv4(IPv4ДоЗоны) Тогда
		ВызватьОшибкуЗоныДляIPv4();
	КонецЕсли;

	Если ЭтоПохожеНаIPv4(Значение) Тогда
		Парсер = Новый ПарсерIPv4Адресов();
		Октеты = Парсер.Разобрать(Значение);
		Возврат СоздатьДанныеАдреса(Октеты, Неопределено);
	КонецЕсли;

	Если ЭтоПохожеНаIPv6(Значение) Тогда
		Парсер = Новый ПарсерIPv6Адресов();
		Возврат Парсер.Разобрать(Значение);
	КонецЕсли;

	ВызватьОшибкуНедопустимогоАдреса();

КонецФункции

Функция ЭтоСтрогийIPv4(Значение)

	Попытка
		Парсер = Новый ПарсерIPv4Адресов();
		Парсер.Разобрать(Значение);
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

Функция ЭтоПохожеНаIPv4(Значение)

	Если СтрНайти(Значение, ":") > 0 Или СтрНайти(Значение, "%") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ПервыйСимвол = Лев(Значение, 1);
	КодПервогоСимвола = КодСимвола(ПервыйСимвол);
	ЭтоЦифра = КодПервогоСимвола >= 48 И КодПервогоСимвола <= 57;

	Возврат СтрНайти(Значение, ".") > 0 Или ЭтоЦифра;

КонецФункции

Функция ЭтоПохожеНаIPv6(Значение)

	Если СтрНайти(Значение, ":") > 0 Или СтрНайти(Значение, "%") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СтрДлина(Значение) <= 4;

КонецФункции

Процедура ВызватьОшибкуНедопустимогоАдреса()

	ВызватьИсключение ОшибкиIP.Создать(
		КодыОшибокIP.НедопустимыйIPАдрес(),
		"Строка не является IP-адресом",
		"Адрес"
	);

КонецПроцедуры

Процедура ВызватьОшибкуЗоныДляIPv4()

	ВызватьИсключение ОшибкиIP.Создать(
		КодыОшибокIP.ЗонаНедопустимаДляIPv4(),
		"Зона недопустима для IPv4-адреса",
		"Зона"
	);

КонецПроцедуры

Процедура ПроверитьЗону(Зона)

	Если ТипЗнч(Зона) <> Тип("Строка") Тогда
		ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
			"Зона",
			"Строка",
			Зона
		);
	КонецЕсли;

	ЗонаНедопустима = СтрДлина(Зона) = 0
		Или СтрНайти(Зона, "%") > 0
		Или СтрНайти(Зона, "[") > 0
		Или СтрНайти(Зона, "]") > 0
		Или СтрНайти(Зона, Символы.ВК) > 0
		Или СтрНайти(Зона, Символы.ПС) > 0;

	Если Не ЗонаНедопустима Тогда
		Для Позиция = 1 По СтрДлина(Зона) Цикл
			Если КодСимвола(Сред(Зона, Позиция, 1)) = 0 Тогда
				ЗонаНедопустима = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если ЗонаНедопустима Тогда
		ВызватьИсключение ОшибкиIP.Создать(
			КодыОшибокIP.НедопустимаяЗона(),
			"Недопустимая зона IPv6-адреса",
			"Зона"
		);
	КонецЕсли;

КонецПроцедуры

Функция СоздатьАдресСЗоной(Зона)

	Если Зона = Неопределено Тогда
		Возврат Новый IPАдрес(_Состояние.Октеты());
	КонецЕсли;

	ШестнадцатеричнаяСтрока = ПолучитьHexСтрокуИзДвоичныхДанных(_Состояние.Байты());
	Представление = "";

	Для НомерГруппы = 0 По 7 Цикл
		Если НомерГруппы > 0 Тогда
			Представление = Представление + ":";
		КонецЕсли;
		НачалоГруппы = НомерГруппы * 4 + 1;
		Представление = Представление + Сред(ШестнадцатеричнаяСтрока, НачалоГруппы, 4);
	КонецЦикла;

	Возврат Новый IPАдрес(Представление + "%" + Зона);

КонецФункции

Процедура ПроверитьОктеты(Октеты)

	Если Октеты.Количество() <> 4 И Октеты.Количество() <> 16 Тогда
		ВызватьИсключение ОшибкиIP.Создать(
			КодыОшибокIP.НедопустимаяДлинаБайтов(),
			"Длина последовательности октетов IP-адреса должна быть равна 4 или 16"
		);
	КонецЕсли;

	Для Каждого Октет Из Октеты Цикл
		ПроверитьОктет(Октет);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОктет(Октет)

	Если ТипЗнч(Октет) <> Тип("Число") Тогда
		ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
			"Октет",
			"Число",
			Октет
		);
	КонецЕсли;

	Если Октет <> Цел(Октет) Тогда
		ВызватьИсключение СтандартныеОшибки.НедопустимоеЗначениеАргумента(
			"Октет",
			"целое число"
		);
	КонецЕсли;

	Если Октет < 0 Или Октет > 255 Тогда
		ВызватьИсключение СтандартныеОшибки.АргументВнеДиапазона(
			"Октет",
			"от 0 до 255 включительно"
		);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьДлинуПрефикса(ДлинаПрефикса)

	Если ТипЗнч(ДлинаПрефикса) <> Тип("Число") Тогда
		ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
			"ДлинаПрефикса",
			"Число",
			ДлинаПрефикса
		);
	КонецЕсли;

	Если ДлинаПрефикса <> Цел(ДлинаПрефикса) Тогда
		ВызватьИсключение СтандартныеОшибки.НедопустимоеЗначениеАргумента(
			"ДлинаПрефикса",
			"целое число"
		);
	КонецЕсли;

	Если ДлинаПрефикса < 0 Или ДлинаПрефикса > ДлинаВБитах() Тогда
		ВызватьИсключение СтандартныеОшибки.АргументВнеДиапазона(
			"ДлинаПрефикса",
			"от 0 до " + Строка(ДлинаВБитах()) + " включительно"
		);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
