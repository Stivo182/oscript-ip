#Область ПрограммныйИнтерфейс

// Возвращает код недопустимого IP-адреса.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция НедопустимыйIPАдрес() Экспорт

	Возврат "ip.invalid_address";

КонецФункции

// Возвращает код недопустимого IPv4-адреса.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция НедопустимыйIPv4() Экспорт

	Возврат "ip.invalid_ipv4";

КонецФункции

// Возвращает код недопустимого IPv6-адреса.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция НедопустимыйIPv6() Экспорт

	Возврат "ip.invalid_ipv6";

КонецФункции

// Возвращает код недопустимой зоны IPv6-адреса.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция НедопустимаяЗона() Экспорт

	Возврат "ip.invalid_zone";

КонецФункции

// Возвращает код недопустимой зоны IPv4-адреса.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция ЗонаНедопустимаДляIPv4() Экспорт

	Возврат "ip.zone_not_allowed_for_ipv4";

КонецФункции

// Возвращает код недопустимого количества октетов IP-адреса.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция НедопустимоеКоличествоОктетов() Экспорт

	Возврат "ip.invalid_byte_length";

КонецФункции

// Возвращает код недопустимого IP-префикса.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция НедопустимыйПрефикс() Экспорт

	Возврат "ip.invalid_prefix";

КонецФункции

// Возвращает код длины префикса вне допустимого диапазона.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция ДлинаПрефиксаВнеДиапазона() Экспорт

	Возврат "ip.prefix_length_out_of_range";

КонецФункции

// Возвращает код установленных битов узла в базовом адресе префикса.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция УстановленыБитыУзла() Экспорт

	Возврат "ip.prefix.host_bits_set";

КонецФункции

// Возвращает код недопустимой IP-конечной точки.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция НедопустимаяКонечнаяТочка() Экспорт

	Возврат "ip.invalid_endpoint";

КонецФункции

// Возвращает код порта вне допустимого диапазона.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция ПортВнеДиапазона() Экспорт

	Возврат "ip.port_out_of_range";

КонецФункции

// Возвращает код несовместимых семейств IP-адресов.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция НесовместимыеСемейства() Экспорт

	Возврат "ip.family_mismatch";

КонецФункции

#КонецОбласти
