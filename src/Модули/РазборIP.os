Функция ПопытатьсяРазобратьКонечнуюТочку(Знач Представление, Ошибка = Неопределено) Экспорт

	ПроверкаАргументов.ПроверитьТип("Представление", Представление, Тип("Строка"));
	Ошибка = Неопределено;

	Попытка
		Возврат Новый IPКонечнаяТочка(Представление);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти
