#Использовать errors

#Область ПрограммныйИнтерфейс

// Разбирает строковое представление IP-адреса без выбрасывания исключения при ошибке разбора.
//
// Параметры:
//  Представление - Строка - Строковое представление IP-адреса.
//  Ошибка - ИнформацияОбОшибке, Неопределено - Выходной параметр с информацией об ошибке разбора.
//
// Возвращаемое значение:
//  IPАдрес, Неопределено - Разобранный адрес или Неопределено при ошибке формата.
//
// Исключения:
//  argument.invalid_type - Представление имеет неверный тип.
Функция ПопытатьсяРазобратьАдрес(Знач Представление, Ошибка = Неопределено) Экспорт

	ПроверкаАргументов.ПроверитьТип("Представление", Представление, Тип("Строка"));
	Ошибка = Неопределено;

	Попытка
		Возврат Новый IPАдрес(Представление);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

