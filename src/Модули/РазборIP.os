#Использовать errors
#Использовать "../internal"

#Область ПрограммныйИнтерфейс

// Разбирает строковое представление IP-адреса без выбрасывания исключения при ошибке разбора.
//
// Параметры:
//  Представление - Строка - Строковое представление IP-адреса.
//  Ошибка - ИнформацияОбОшибке, Неопределено - Выходной параметр с информацией об ошибке разбора.
//
// Возвращаемое значение:
//  IPАдрес, Неопределено - Разобранный адрес или Неопределено при ошибке формата.
//
// Исключения:
//  argument.invalid_type - Представление имеет неверный тип.
Функция ПопытатьсяРазобратьАдрес(Знач Представление, Ошибка = Неопределено) Экспорт

	ПроверкаАргументов.ПроверитьТип("Представление", Представление, Тип("Строка"));
	Ошибка = Неопределено;

	Попытка
		Возврат Новый IPАдрес(Представление);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Разбирает строковое представление IP-префикса без выбрасывания исключения при ошибке разбора.
//
// Параметры:
//  Представление - Строка - Строковое представление IP-префикса.
//  Ошибка - ИнформацияОбОшибке, Неопределено - Выходной параметр с информацией об ошибке разбора.
//
// Возвращаемое значение:
//  IPПрефикс, Неопределено - Разобранный префикс или Неопределено при ошибке формата.
//
// Исключения:
//  argument.invalid_type - Представление имеет неверный тип.
Функция ПопытатьсяРазобратьПрефикс(Знач Представление, Ошибка = Неопределено) Экспорт

	ПроверкаАргументов.ПроверитьТип("Представление", Представление, Тип("Строка"));
	Ошибка = Неопределено;

	Попытка
		Возврат Новый IPПрефикс(Представление);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Разбирает строковое представление IP-сети и обнуляет биты узла.
//
// Ссылки:
//  RFC 4632 §3.1 - бесклассовая адресация IPv4 и запись CIDR:
//  https://www.rfc-editor.org/rfc/rfc4632.html#section-3.1
//  RFC 4291 §2.3 - текстовая запись префиксов IPv6:
//  https://www.rfc-editor.org/rfc/rfc4291.html#section-2.3
//
// Параметры:
//  Представление - Строка - IP-адрес и длина префикса в записи CIDR.
//  Ошибка - ИнформацияОбОшибке, Неопределено - Выходной параметр с информацией об ошибке разбора.
//
// Возвращаемое значение:
//  IPПрефикс, Неопределено - Каноническая сеть или Неопределено при ошибке формата.
//
// Исключения:
//  argument.invalid_type - Представление имеет неверный тип.
Функция ПопытатьсяРазобратьСеть(Знач Представление, Ошибка = Неопределено) Экспорт

	ПроверкаАргументов.ПроверитьТип("Представление", Представление, Тип("Строка"));
	Ошибка = Неопределено;

	Попытка
		ДанныеСети = Новый ПарсерIPПрефиксов().Разобрать(Представление);
		Возврат ДанныеСети.Адрес.СоздатьПрефикс(ДанныеСети.ДлинаПрефикса);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Разбирает строковое представление IP-конечной точки без выбрасывания исключения при ошибке разбора.
//
