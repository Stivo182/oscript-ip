#Использовать "../src"

Перем _IPv4;
Перем _IPv6;
Перем _ДругойIPv4;
Перем _ДругойIPv6;
Перем _ДвоичныеДанныеIPv4;
Перем _ДвоичныеДанныеIPv6;
Перем _ОктетыIPv4;
Перем _ОктетыIPv6;
Перем _ФиксированныеОктетыIPv4;
Перем _ФиксированныеОктетыIPv6;

#Область ОбработчикиСобытий

&МониторингПамяти
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередКаждымКейсом
Процедура ПодготовитьIPАдреса(Контекст) Экспорт

	_IPv4 = Новый IPАдрес("192.0.2.1");
	_IPv6 = Новый IPАдрес("2001:db8::1");
	_ДругойIPv4 = Новый IPАдрес("192.0.2.1");
	_ДругойIPv6 = Новый IPАдрес("2001:db8::1");
	_ДвоичныеДанныеIPv4 = ПолучитьДвоичныеДанныеИзHexСтроки("C0000201");
	_ДвоичныеДанныеIPv6 = ПолучитьДвоичныеДанныеИзHexСтроки("20010DB8000000000000000000000001");
	_ФиксированныеОктетыIPv4 = _IPv4.Октеты();
	_ФиксированныеОктетыIPv6 = _IPv6.Октеты();
	_ОктетыIPv4 = Новый Массив;
	_ОктетыIPv6 = Новый Массив;

	Для Каждого Октет Из _ФиксированныеОктетыIPv4 Цикл
		_ОктетыIPv4.Добавить(Октет);
	КонецЦикла;

	Для Каждого Октет Из _ФиксированныеОктетыIPv6 Цикл
		_ОктетыIPv6.Добавить(Октет);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

// Разбирает IPv4-адрес из строки по RFC 791.
&Бенчмарк(Наименование = "IPv4 из строки")
&Категория("Создание")
Процедура РазобратьIPv4() Экспорт

	Результат = Новый IPАдрес("192.0.2.1");

КонецПроцедуры

// Разбирает полную форму IPv6-адреса по RFC 4291.
&Бенчмарк(Наименование = "IPv6 из строки, полная форма")
&Категория("Создание")
Процедура РазобратьПолныйIPv6() Экспорт

	Результат = Новый IPАдрес("2001:0db8:0000:0000:0000:0000:0000:0001");

КонецПроцедуры

// Разбирает сокращённую форму IPv6-адреса по RFC 4291.
&Бенчмарк(Наименование = "IPv6 из строки, сокращённая форма")
&Категория("Создание")
Процедура РазобратьСокращённыйIPv6() Экспорт

	Результат = Новый IPАдрес("2001:db8::1");

КонецПроцедуры

// Создаёт IPv4-адрес копированием другого IP-адреса.
&Бенчмарк(Наименование = "IPv4 из IPАдреса")
&Категория("Создание")
Процедура СоздатьIPv4ИзIPАдреса() Экспорт

	Результат = Новый IPАдрес(_IPv4);

КонецПроцедуры

// Создаёт IPv6-адрес копированием другого IP-адреса.
&Бенчмарк(Наименование = "IPv6 из IPАдреса")
&Категория("Создание")
Процедура СоздатьIPv6ИзIPАдреса() Экспорт

	Результат = Новый IPАдрес(_IPv6);

КонецПроцедуры

// Создаёт IPv4-адрес из двоичных данных.
&Бенчмарк(Наименование = "IPv4 из двоичных данных")
&Категория("Создание")
Процедура СоздатьIPv4ИзДвоичныхДанных() Экспорт

	Результат = Новый IPАдрес(_ДвоичныеДанныеIPv4);

КонецПроцедуры

// Создаёт IPv6-адрес из двоичных данных.
&Бенчмарк(Наименование = "IPv6 из двоичных данных")
&Категория("Создание")
Процедура СоздатьIPv6ИзДвоичныхДанных() Экспорт

	Результат = Новый IPАдрес(_ДвоичныеДанныеIPv6);

КонецПроцедуры

// Создаёт IPv4-адрес из изменяемого массива октетов.
&Бенчмарк(Наименование = "IPv4 из массива")
&Категория("Создание")
Процедура СоздатьIPv4ИзМассива() Экспорт

	Результат = Новый IPАдрес(_ОктетыIPv4);

КонецПроцедуры

// Создаёт IPv6-адрес из изменяемого массива октетов.
&Бенчмарк(Наименование = "IPv6 из массива")
&Категория("Создание")
Процедура СоздатьIPv6ИзМассива() Экспорт

	Результат = Новый IPАдрес(_ОктетыIPv6);

КонецПроцедуры

// Создаёт IPv4-адрес из неизменяемого массива октетов.
&Бенчмарк(Наименование = "IPv4 из фиксированного массива")
&Категория("Создание")
Процедура СоздатьIPv4ИзФиксированногоМассива() Экспорт

	Результат = Новый IPАдрес(_ФиксированныеОктетыIPv4);

КонецПроцедуры

// Создаёт IPv6-адрес из неизменяемого массива октетов.
&Бенчмарк(Наименование = "IPv6 из фиксированного массива")
&Категория("Создание")
Процедура СоздатьIPv6ИзФиксированногоМассива() Экспорт

	Результат = Новый IPАдрес(_ФиксированныеОктетыIPv6);

КонецПроцедуры

// Форматирует IPv4-адрес.
&Бенчмарк(Наименование = "IPv4")
&Категория("Форматирование")
Процедура ФорматироватьIPv4() Экспорт

	Результат = _IPv4.ВСтроку();

КонецПроцедуры

// Форматирует IPv6-адрес по RFC 5952.
&Бенчмарк(Наименование = "IPv6")
&Категория("Форматирование")
Процедура ФорматироватьIPv6() Экспорт

	Результат = _IPv6.ВСтроку();

КонецПроцедуры

// Проверяет равенство IPv4-адресов.
&Бенчмарк(Наименование = "Равенство IPv4")
&Категория("Операции")
Процедура ПроверитьРавенствоIPv4() Экспорт

	Результат = _IPv4.Равно(_ДругойIPv4);

КонецПроцедуры

// Проверяет равенство IPv6-адресов.
&Бенчмарк(Наименование = "Равенство IPv6")
&Категория("Операции")
Процедура ПроверитьРавенствоIPv6() Экспорт

	Результат = _IPv6.Равно(_ДругойIPv6);

КонецПроцедуры

// Сравнивает IPv4-адреса.
&Бенчмарк(Наименование = "Сравнение IPv4")
&Категория("Операции")
Процедура СравнитьIPv4() Экспорт

	Результат = _IPv4.Сравнить(_ДругойIPv4);

КонецПроцедуры

// Сравнивает IPv6-адреса.
&Бенчмарк(Наименование = "Сравнение IPv6")
&Категория("Операции")
Процедура СравнитьIPv6() Экспорт

	Результат = _IPv6.Сравнить(_ДругойIPv6);

КонецПроцедуры

#КонецОбласти
