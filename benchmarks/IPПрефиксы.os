#Использовать "../src"

Перем _IPv4;
Перем _IPv6;
Перем _ПрефиксIPv4;
Перем _ПрефиксIPv6;
Перем _ДругойПрефиксIPv4;
Перем _ДругойПрефиксIPv6;

#Область ОбработчикиСобытий

&МониторингПамяти
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередКаждымКейсом
Процедура ПодготовитьIPПрефиксы(Контекст) Экспорт

	_IPv4 = Новый IPАдрес("192.0.2.42");
	_IPv6 = Новый IPАдрес("2001:db8::42");
	_ПрефиксIPv4 = Новый IPПрефикс("192.0.2.0/24");
	_ПрефиксIPv6 = Новый IPПрефикс("2001:db8::/32");
	_ДругойПрефиксIPv4 = Новый IPПрефикс("192.0.2.0/24");
	_ДругойПрефиксIPv6 = Новый IPПрефикс("2001:db8::/32");

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

// Разбирает IPv4-префикс в записи CIDR по RFC 4632.
&Бенчмарк(Наименование = "IPv4 из строки")
&Категория("Создание")
Процедура РазобратьПрефиксIPv4() Экспорт

	Результат = Новый IPПрефикс("192.0.2.0/24");

КонецПроцедуры

// Разбирает IPv6-префикс по RFC 4291.
&Бенчмарк(Наименование = "IPv6 из строки")
&Категория("Создание")
Процедура РазобратьПрефиксIPv6() Экспорт

	Результат = Новый IPПрефикс("2001:db8::/32");

КонецПроцедуры

// Проверяет вхождение IPv4-адреса в префикс.
&Бенчмарк(Наименование = "Вхождение IPv4")
&Категория("Операции")
Процедура ПроверитьВхождениеIPv4() Экспорт

	Результат = _ПрефиксIPv4.Содержит(_IPv4);

КонецПроцедуры

// Проверяет вхождение IPv6-адреса в префикс.
&Бенчмарк(Наименование = "Вхождение IPv6")
&Категория("Операции")
Процедура ПроверитьВхождениеIPv6() Экспорт

	Результат = _ПрефиксIPv6.Содержит(_IPv6);

КонецПроцедуры

// Создаёт маску IPv4-префикса.
&Бенчмарк(Наименование = "Маска IPv4")
&Категория("Создание")
Процедура СоздатьМаскуIPv4() Экспорт

	Результат = _ПрефиксIPv4.Маска();

КонецПроцедуры

// Создаёт маску IPv6-префикса.
&Бенчмарк(Наименование = "Маска IPv6")
&Категория("Создание")
Процедура СоздатьМаскуIPv6() Экспорт

	Результат = _ПрефиксIPv6.Маска();

КонецПроцедуры

// Создаёт последний адрес IPv4-префикса.
&Бенчмарк(Наименование = "Последний адрес IPv4")
&Категория("Создание")
Процедура СоздатьПоследнийАдресIPv4() Экспорт

	Результат = _ПрефиксIPv4.ПоследнийАдрес();

КонецПроцедуры

// Создаёт последний адрес IPv6-префикса.
&Бенчмарк(Наименование = "Последний адрес IPv6")
&Категория("Создание")
Процедура СоздатьПоследнийАдресIPv6() Экспорт

	Результат = _ПрефиксIPv6.ПоследнийАдрес();

КонецПроцедуры

// Проверяет пересечение IPv4-префиксов.
&Бенчмарк(Наименование = "Пересечение IPv4")
&Категория("Операции")
Процедура ПроверитьПересечениеIPv4() Экспорт

	Результат = _ПрефиксIPv4.Пересекается(_ДругойПрефиксIPv4);

КонецПроцедуры

// Проверяет пересечение IPv6-префиксов.
&Бенчмарк(Наименование = "Пересечение IPv6")
&Категория("Операции")
Процедура ПроверитьПересечениеIPv6() Экспорт

	Результат = _ПрефиксIPv6.Пересекается(_ДругойПрефиксIPv6);

КонецПроцедуры

// Проверяет равенство IPv4-префиксов.
&Бенчмарк(Наименование = "Равенство IPv4")
&Категория("Операции")
Процедура ПроверитьРавенствоIPv4() Экспорт

	Результат = _ПрефиксIPv4.Равно(_ДругойПрефиксIPv4);

КонецПроцедуры

// Проверяет равенство IPv6-префиксов.
&Бенчмарк(Наименование = "Равенство IPv6")
&Категория("Операции")
Процедура ПроверитьРавенствоIPv6() Экспорт

	Результат = _ПрефиксIPv6.Равно(_ДругойПрефиксIPv6);

КонецПроцедуры

// Сравнивает IPv4-префиксы.
&Бенчмарк(Наименование = "Сравнение IPv4")
&Категория("Операции")
Процедура СравнитьIPv4() Экспорт

	Результат = _ПрефиксIPv4.Сравнить(_ДругойПрефиксIPv4);

КонецПроцедуры

// Сравнивает IPv6-префиксы.
&Бенчмарк(Наименование = "Сравнение IPv6")
&Категория("Операции")
Процедура СравнитьIPv6() Экспорт

	Результат = _ПрефиксIPv6.Сравнить(_ДругойПрефиксIPv6);

КонецПроцедуры

#КонецОбласти
