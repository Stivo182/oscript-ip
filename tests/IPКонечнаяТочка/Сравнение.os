#Область Тесты

&Тест
Процедура ТестДолжен_СчитатьРавнымиКонечныеТочкиСОдинаковымиАдресомИПортом() Экспорт

	// Подготовка
	ПерваяКонечнаяТочка = Новый IPКонечнаяТочка("[2001:0db8:0:0:0:0:0:1]:443");
	ВтораяКонечнаяТочка = Новый IPКонечнаяТочка("[2001:db8::1]:443");

	// Действие
	Результат = ПерваяКонечнаяТочка.Равно(ВтораяКонечнаяТочка);

	// Проверка
	Ожидаем.Что(Результат).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_УчитыватьЗонуИПортПриРавенствеКонечныхТочек() Экспорт

	// Подготовка
	БезЗоны = Новый IPКонечнаяТочка("[fe80::1]:443");
	СЗоной = Новый IPКонечнаяТочка("[fe80::1%eth0]:443");
	СДругимПортом = Новый IPКонечнаяТочка("[fe80::1%eth0]:444");

	// Действие и Проверка
	Ожидаем.Что(БезЗоны.Равно(СЗоной)).ЭтоЛожь();
	Ожидаем.Что(СЗоной.Равно(СДругимПортом)).ЭтоЛожь();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("192.0.2.1:80", "192.0.2.1:443", -1)
&ИсточникЗначение("192.0.2.2:80", "192.0.2.1:65535", 1)
&ИсточникЗначение("[fe80::1]:80", "[fe80::1%eth0]:0", -1)
&ИсточникЗначение("[fe80::1%eth0]:443", "[fe80::1%eth0]:443", 0)
Процедура ТестДолжен_СравниватьКонечныеТочкиПоАдресуЗатемПоПорту(Первый, Второй, Ожидаемое) Экспорт

	// Действие
	Результат = Новый IPКонечнаяТочка(Первый).Сравнить(Новый IPКонечнаяТочка(Второй));

	// Проверка
	Ожидаем.Что(Результат).Равно(Ожидаемое);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Равно")
&ИсточникЗначение("Сравнить")
Процедура ТестДолжен_ОтклонитьНедопустимыйТипДругойКонечнойТочки(Метод) Экспорт

	// Подготовка
	КонечнаяТочка = Новый IPКонечнаяТочка("192.0.2.1:80");

	// Действие
	Ошибка = ОшибкаПриВызовеМетодаСНедопустимымАргументом(КонечнаяТочка, Метод);

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(
		Ошибка,
		КодыСтандартныхОшибок.НеверныйТипАргумента()
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаПриВызовеМетодаСНедопустимымАргументом(КонечнаяТочка, Метод)

	Попытка
		Если Метод = "Равно" Тогда
			Результат = КонечнаяТочка.Равно("192.0.2.1:80");
		Иначе
			Результат = КонечнаяТочка.Сравнить("192.0.2.1:80");
		КонецЕсли;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
