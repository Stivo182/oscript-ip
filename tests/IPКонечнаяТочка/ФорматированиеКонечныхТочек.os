#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("192.0.2.1:80", "192.0.2.1:80")
&ИсточникЗначение("192.0.2.1:00443", "192.0.2.1:443")
&ИсточникЗначение("[2001:0DB8:0:0:0:0:0:1]:00443", "[2001:db8::1]:443")
&ИсточникЗначение("[fe80::1%eth0]:8080", "[fe80::1%eth0]:8080")
Процедура ТестДолжен_ВернутьКаноническуюСтрокуКонечнойТочки(Вход, Ожидаемое) Экспорт

	// Действие
	Результат = Новый IPКонечнаяТочка(Вход).ВСтроку();

	// Проверка
	Ожидаем.Что(Результат).Равно(Ожидаемое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьАдресСЗонойИЧисловойПорт() Экспорт

	// Подготовка
	КонечнаяТочка = Новый IPКонечнаяТочка("[fe80::1%eth0]:443");

	// Действие
	Адрес = КонечнаяТочка.Адрес();
	Порт = КонечнаяТочка.Порт();

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно("fe80::1%eth0");
	Ожидаем.Что(Адрес.Зона()).Равно("eth0");
	Ожидаем.Что(Порт).Равно(443);

КонецПроцедуры

#КонецОбласти
