	Ошибка = ОшибкаПриСозданииКонечнойТочки(Значение);

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, КодыОшибокIP.ПортВнеДиапазона());

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(-1)
&ИсточникЗначение(65536)
&ИсточникЗначение(80.5)
Процедура ТестДолжен_ОтклонитьЧисловойПортВнеДиапазона(Порт) Экспорт

	// Действие
	Ошибка = ОшибкаПриСозданииКонечнойТочки(Новый IPАдрес("192.0.2.1"), Порт, Истина);

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, КодыСтандартныхОшибок.АргументВнеДиапазона());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьОтсутствующийПортДляIPАдреса() Экспорт

	// Действие
	Ошибка = ОшибкаПриСозданииКонечнойТочки(Новый IPАдрес("192.0.2.1"));

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(
