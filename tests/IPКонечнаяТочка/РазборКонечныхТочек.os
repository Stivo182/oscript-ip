&Тест
Процедура ТестДолжен_ОтклонитьТекстовыйПортВСтрогомКонструкторе() Экспорт

	// Действие
	Ошибка = ОшибкаПриСозданииКонечнойТочки(Новый IPАдрес("192.0.2.1"), "80", Истина);

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, КодыСтандартныхОшибок.НеверныйТипАргумента());

КонецПроцедуры

&Тест
Процедура ТестДолжен_УказатьПортВОшибкеТипаОтдельногоПортаДляСтроковогоАдреса() Экспорт

	// Действие
	Ошибка = ОшибкаПриСозданииКонечнойТочки("192.0.2.1", "80", Истина);

	// Проверка
	КодОшибки = КодыСтандартныхОшибок.НеверныйТипАргумента();
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, КодОшибки);
	Снимок = ДиагностикаОшибок.НайтиПервую(Ошибка, КодОшибки);
	Ожидаем.Что(Снимок.Данные().ИмяАргумента).Равно("Порт");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьЛишнийПортПриКопировании() Экспорт

	// Подготовка
	ИсходнаяКонечнаяТочка = Новый IPКонечнаяТочка("192.0.2.1:80");

	// Действие
	Ошибка = ОшибкаПриСозданииКонечнойТочки(ИсходнаяКонечнаяТочка, 81, Истина);

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, КодыСтандартныхОшибок.НеверныйТипАргумента());

КонецПроцедуры

