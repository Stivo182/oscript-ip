&Тест
Процедура ТестДолжен_ОтклонитьNullВКачествеАдреса() Экспорт

	// Действие
	Ошибка = ОшибкаПриСозданииКонечнойТочки(Null, 80, Истина);

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, КодыСтандартныхОшибок.НеверныйТипАргумента());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаПриСозданииКонечнойТочки(Адрес, Порт = Неопределено, ЕстьПорт = Ложь)

	Попытка
		Если ЕстьПорт Тогда
			КонечнаяТочка = Новый IPКонечнаяТочка(Адрес, Порт);
		Иначе
			КонечнаяТочка = Новый IPКонечнаяТочка(Адрес);
		КонецЕсли;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
