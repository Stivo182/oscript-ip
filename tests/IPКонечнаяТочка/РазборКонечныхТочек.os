#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("192.0.2.1:80", "192.0.2.1:80")
&ИсточникЗначение("192.0.2.1:00443", "192.0.2.1:443")
&ИсточникЗначение("[::1]:80", "[::1]:80")
&ИсточникЗначение("[2001:db8::1]:443", "[2001:db8::1]:443")
&ИсточникЗначение("[fe80::1%eth0]:8080", "[fe80::1%eth0]:8080")
Процедура ТестДолжен_РазобратьКорректнуюКонечнуюТочку(Значение, Ожидаемое) Экспорт

	// Действие
	КонечнаяТочка = Новый IPКонечнаяТочка(Значение);

	// Проверка
	Ожидаем.Что(КонечнаяТочка.ВСтроку()).Равно(Ожидаемое);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("192.0.2.1", 0, "192.0.2.1:0")
&ИсточникЗначение("192.0.2.1", 65535, "192.0.2.1:65535")
&ИсточникЗначение("fe80::1%eth0", 443, "[fe80::1%eth0]:443")
Процедура ТестДолжен_СоздатьКонечнуюТочкуИзАдресаИЧисловогоПорта(Адрес, Порт, Ожидаемое) Экспорт

	// Действие
	КонечнаяТочка = Новый IPКонечнаяТочка(Новый IPАдрес(Адрес), Порт);

	// Проверка
	Ожидаем.Что(КонечнаяТочка.ВСтроку()).Равно(Ожидаемое);
	Ожидаем.Что(КонечнаяТочка.Порт()).Равно(Порт);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("192.0.2.1", 443, "192.0.2.1:443")
&ИсточникЗначение("2001:db8::1", 443, "[2001:db8::1]:443")
Процедура ТестДолжен_СоздатьКонечнуюТочкуИзСтрокиАдресаИЧисловогоПорта(Адрес, Порт, Ожидаемое) Экспорт

	// Действие
	КонечнаяТочка = Новый IPКонечнаяТочка(Адрес, Порт);

	// Проверка
	Ожидаем.Что(КонечнаяТочка.ВСтроку()).Равно(Ожидаемое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СкопироватьКонечнуюТочку() Экспорт

	// Подготовка
	ИсходнаяКонечнаяТочка = Новый IPКонечнаяТочка("[fe80::1%eth0]:443");

	// Действие
	Копия = Новый IPКонечнаяТочка(ИсходнаяКонечнаяТочка);

	// Проверка
	Ожидаем.Что(Копия.ВСтроку()).Равно("[fe80::1%eth0]:443");
	Ожидаем.Что(Копия.Порт()).Равно(443);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("example.com:80")
&ИсточникЗначение("localhost:80")
&ИсточникЗначение("::1:80")
&ИсточникЗначение("[::1]")
&ИсточникЗначение("[::1]:")
&ИсточникЗначение("[::1:80")
&ИсточникЗначение("::1]:80")
&ИсточникЗначение("[::1]80")
&ИсточникЗначение("[::1]:80:1")
&ИсточникЗначение("192.0.2.1:")
&ИсточникЗначение("192.0.2.1:abc")
&ИсточникЗначение("192.0.2.1:+80")
&ИсточникЗначение("192.0.2.1:-1")
&ИсточникЗначение("192.0.2.1:80.5")
Процедура ТестДолжен_ОтклонитьНекорректнуюСтруктуруКонечнойТочки(Значение) Экспорт

	// Действие
	Ошибка = ОшибкаПриСозданииКонечнойТочки(Значение);

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, КодыОшибокIP.НедопустимаяКонечнаяТочка());

КонецПроцедуры

