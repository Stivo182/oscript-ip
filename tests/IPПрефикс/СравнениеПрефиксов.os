#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("192.0.2.0/24", "192.0.2.0/25", -1)
&ИсточникЗначение("192.0.2.0/25", "192.0.2.0/24", 1)
&ИсточникЗначение("192.0.2.0/24", "192.0.3.0/24", -1)
&ИсточникЗначение("192.0.3.0/24", "192.0.2.0/24", 1)
&ИсточникЗначение("192.0.2.0/24", "2001:db8::/32", -1)
&ИсточникЗначение("192.0.2.0/24", "192.0.2.0/24", 0)
&ИсточникЗначение("1.2.3.0/24", "1.2.4.0/24", -1)
&ИсточникЗначение("fe80::/64", "fe90::/64", -1)
&ИсточникЗначение("1.2.0.0/16", "1.2.0.0/24", -1)
&ИсточникЗначение("fe80::/48", "fe80::/64", -1)
&ИсточникЗначение("1.2.3.0/24", "fe00::/8", -1)
Процедура ТестДолжен_СравниватьПрефиксыВДетерминированномПорядке(Первый, Второй, Ожидаемое) Экспорт

	// Действие
	Результат = Новый IPПрефикс(Первый).Сравнить(Новый IPПрефикс(Второй));

	// Проверка
	Ожидаем.Что(Результат).Равно(Ожидаемое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоблюдатьАнтисимметричностьИТранзитивностьСравненияПрефиксов() Экспорт

	// Подготовка
	Первый = Новый IPПрефикс("192.0.2.0/24");
	Второй = Новый IPПрефикс("192.0.2.0/25");
	Третий = Новый IPПрефикс("192.0.2.128/25");

	// Действие и Проверка
	Ожидаем.Что(Первый.Сравнить(Второй)).Равно(-1);
	Ожидаем.Что(Второй.Сравнить(Первый)).Равно(1);
	Ожидаем.Что(Второй.Сравнить(Третий)).Равно(-1);
	Ожидаем.Что(Первый.Сравнить(Третий)).Равно(-1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьДругойТипПриУпорядочивающемСравнении() Экспорт

	// Подготовка
	Префикс = Новый IPПрефикс("192.0.2.0/24");

	// Действие
	Ошибка = ОшибкаПриУпорядочивающемСравнении(Префикс);

	// Проверка
	КодОшибки = КодыСтандартныхОшибок.НеверныйТипАргумента();
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, КодОшибки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаПриУпорядочивающемСравнении(Префикс)

	Попытка
		Результат = Префикс.Сравнить("192.0.2.0/24");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
