#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("0.0.0.0/0")
&ИсточникЗначение("192.168.1.0/24")
&ИсточникЗначение("192.168.1.42/32")
&ИсточникЗначение("::/0")
&ИсточникЗначение("2001:db8::/32")
&ИсточникЗначение("2001:db8::1/128")
Процедура ТестДолжен_СоблюдатьИнвариантыКаноническогоПрефикса(Вход) Экспорт

	// Подготовка
	Префикс = Новый IPПрефикс(Вход);

	// Действие
	ПовторноРазобранный = Новый IPПрефикс(Префикс.ВСтроку());
	БазовыйАдрес = Префикс.БазовыйАдрес();
	ПервыйАдрес = Префикс.ПервыйАдрес();
	ПоследнийАдрес = Префикс.ПоследнийАдрес();

	// Проверка
	Ожидаем.Что(ПовторноРазобранный.Равно(Префикс)).ЭтоИстина();
	Ожидаем.Что(ПервыйАдрес.Равно(БазовыйАдрес)).ЭтоИстина();
	Ожидаем.Что(Префикс.Содержит(БазовыйАдрес)).ЭтоИстина();
	Ожидаем.Что(Префикс.Содержит(ПоследнийАдрес)).ЭтоИстина();
	Ожидаем.Что(БазовыйАдрес.ЕстьЗона()).ЭтоЛожь();
	Ожидаем.Что(ПоследнийАдрес.ЕстьЗона()).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти
