Процедура ТестДолжен_ОпределитьПересечениеПрефиксов(ПервыйТекст, ВторойТекст, Ожидание) Экспорт

	// Подготовка
	Первый = Новый IPПрефикс(ПервыйТекст);
	Второй = Новый IPПрефикс(ВторойТекст);

	// Действие
	Результат = Первый.Пересекается(Второй);

	// Проверка
	Ожидаем.Что(Результат).Равно(Ожидание);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНедопустимыйТипПрефиксаПриПроверкеПересечения() Экспорт

	// Подготовка
	Префикс = Новый IPПрефикс("192.0.2.0/24");

	// Действие
	Ошибка = ОшибкаПриПроверкеПересечения(Префикс, "192.0.2.0/24");

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(
		Ошибка,
		КодыСтандартныхОшибок.НеверныйТипАргумента()
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаПриПроверкеПересечения(Префикс, Другой)

	Попытка
		Результат = Префикс.Пересекается(Другой);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
