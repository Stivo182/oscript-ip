#Использовать asserts
#Использовать "../../src"

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("192.168.1.42", 24, "192.168.1.0/24")
&ИсточникЗначение("255.255.255.255", 20, "255.255.240.0/20")
&ИсточникЗначение("100.98.156.66", 10, "100.64.0.0/10")
&ИсточникЗначение("2001:db8::1", 32, "2001:db8::/32")
&ИсточникЗначение("fe80:1234:5678::1%eth0", 48, "fe80:1234:5678::/48")
&ИсточникЗначение("fe80::dead:beef:dead:beef%eth0", 96, "fe80::dead:beef:0:0/96")
&ИсточникЗначение("aaaa::", 4, "a000::/4")
Процедура ТестДолжен_МаскироватьАдресПриСозданииПрефикса(ТекстАдреса, ДлинаПрефикса, ОжидаемыйПрефикс) Экспорт

	// Подготовка
	Адрес = Новый IPАдрес(ТекстАдреса);
	ИсходноеПредставление = Адрес.ВСтроку();
	ИсходнаяЗона = Адрес.ИмеетЗону();

	// Действие
	Префикс = Адрес.СоздатьПрефикс(ДлинаПрефикса);

	// Проверка
	Ожидаем.Что(Префикс.ВСтроку()).Равно(ОжидаемыйПрефикс);
	Ожидаем.Что(Адрес.ВСтроку()).Равно(ИсходноеПредставление);
	Ожидаем.Что(Адрес.ИмеетЗону()).Равно(ИсходнаяЗона);
	Ожидаем.Что(Префикс.БазовыйАдрес().ИмеетЗону()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьПрефиксыНаГраницахДлиныСемейства() Экспорт

	// Подготовка
	IPv4 = Новый IPАдрес("192.168.1.42");
	IPv6 = Новый IPАдрес("2001:db8::1");

	// Действие
	IPv4Нулевой = IPv4.СоздатьПрефикс(0);
	IPv4Полный = IPv4.СоздатьПрефикс(32);
	IPv6Нулевой = IPv6.СоздатьПрефикс(0);
	IPv6Полный = IPv6.СоздатьПрефикс(128);

	// Проверка
	Ожидаем.Что(IPv4Нулевой.ВСтроку()).Равно("0.0.0.0/0");
	Ожидаем.Что(IPv4Полный.ВСтроку()).Равно("192.168.1.42/32");
	Ожидаем.Что(IPv6Нулевой.ВСтроку()).Равно("::/0");
	Ожидаем.Что(IPv6Полный.ВСтроку()).Равно("2001:db8::1/128");

КонецПроцедуры

#КонецОбласти
