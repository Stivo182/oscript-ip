#Использовать asserts
#Использовать "../../src"

#Область Тесты

&Тест
Процедура ТестДолжен_МаскироватьIPv4АдресПриСозданииПрефикса() Экспорт

	// Действие
	Префикс = Новый IPАдрес("192.168.1.42").Префикс(24);

	// Проверка
	Ожидаем.Что(Префикс.ВСтроку()).Равно("192.168.1.0/24");
	Ожидаем.Что(Префикс.БазовыйАдрес().ЕстьЗона()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_МаскироватьIPv6АдресИОтбрасыватьЗонуПриСозданииПрефикса() Экспорт

	// Действие
	Префикс = Новый IPАдрес("2001:db8:1234:5678::1%eth0").Префикс(48);

	// Проверка
	Ожидаем.Что(Префикс.ВСтроку()).Равно("2001:db8:1234::/48");
	Ожидаем.Что(Префикс.БазовыйАдрес().ЕстьЗона()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьПрефиксыНаГраницахДлиныСемейства() Экспорт

	// Подготовка
	IPv4 = Новый IPАдрес("192.168.1.42");
	IPv6 = Новый IPАдрес("2001:db8::1");

	// Действие
	IPv4Нулевой = IPv4.Префикс(0);
	IPv4Полный = IPv4.Префикс(32);
	IPv6Нулевой = IPv6.Префикс(0);
	IPv6Полный = IPv6.Префикс(128);

	// Проверка
	Ожидаем.Что(IPv4Нулевой.ВСтроку()).Равно("0.0.0.0/0");
	Ожидаем.Что(IPv4Полный.ВСтроку()).Равно("192.168.1.42/32");
	Ожидаем.Что(IPv6Нулевой.ВСтроку()).Равно("::/0");
	Ожидаем.Что(IPv6Полный.ВСтроку()).Равно("2001:db8::1/128");

КонецПроцедуры

#КонецОбласти
