	Ошибка = ОшибкаПриСозданииПрефикса(Значение);

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, КодыОшибокIP.НедопустимыйПрефикс());

КонецПроцедуры

