#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("0.0.0.0/0")
&ИсточникЗначение("192.168.1.0/24")
&ИсточникЗначение("192.168.1.42/32")
&ИсточникЗначение("::/0")
&ИсточникЗначение("2001:db8::/32")
&ИсточникЗначение("2001:db8::1/128")
Процедура ТестДолжен_РазобратьКорректныйСтрогийПрефикс(Значение) Экспорт

	// Действие
	Префикс = Новый IPПрефикс(Значение);

	// Проверка
	Ожидаем.Что(Префикс.ВСтроку()).Равно(Значение);

КонецПроцедуры

&Тест
Процедура ТестДолжен_КанонизироватьТекстIPv6ВСтрокеПрефикса() Экспорт

	// Действие
	Префикс = Новый IPПрефикс("2001:0DB8:0:0::/32");

	// Проверка
	Ожидаем.Что(Префикс.ВСтроку()).Равно("2001:db8::/32");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СкопироватьПрефикс() Экспорт

	// Подготовка
	ИсходныйПрефикс = Новый IPПрефикс("2001:db8::/32");

	// Действие
	Копия = Новый IPПрефикс(ИсходныйПрефикс);

	// Проверка
	Ожидаем.Что(Копия.ВСтроку()).Равно("2001:db8::/32");
	Ожидаем.Что(Копия.БазовыйАдрес().ЕстьЗона()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьСтрогийПрефиксИзКаноническогоIPv4АдресаИДлины() Экспорт

	// Действие
	Префикс = Новый IPПрефикс(Новый IPАдрес("192.168.1.0"), 24);

	// Проверка
	Ожидаем.Что(Префикс.ВСтроку()).Равно("192.168.1.0/24");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьСтрогийПрефиксИзКаноническогоIPv6АдресаИДлины() Экспорт

	// Действие
	Префикс = Новый IPПрефикс(Новый IPАдрес("2001:db8::"), 32);

	// Проверка
	Ожидаем.Что(Префикс.ВСтроку()).Равно("2001:db8::/32");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("192.168.1.0")
&ИсточникЗначение("/24")
&ИсточникЗначение("192.168.1.0/")
&ИсточникЗначение("192.168.1.0/24/1")
&ИсточникЗначение("192.168.1.0/01")
&ИсточникЗначение("192.168.1.0/+24")
&ИсточникЗначение("192.168.1.0/-1")
&ИсточникЗначение("192.168.1.0/ 24")
&ИсточникЗначение("192.168.1.0/24 ")
&ИсточникЗначение("192.168.1.0/24.0")
&ИсточникЗначение("fe80::%eth0/64")
