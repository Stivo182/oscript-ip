#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаПриСозданииПрефикса(Значение, Длина = Неопределено)

	Попытка
		Если Длина = Неопределено Тогда
			Префикс = Новый IPПрефикс(Значение);
		Иначе
			Префикс = Новый IPПрефикс(Значение, Длина);
		КонецЕсли;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
