#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("0.0.0.0/0", "0.0.0.0", "255.255.255.255")
&ИсточникЗначение("128.0.0.0/1", "128.0.0.0", "255.255.255.255")
&ИсточникЗначение("192.168.1.0/24", "255.255.255.0", "192.168.1.255")
&ИсточникЗначение("192.168.1.0/25", "255.255.255.128", "192.168.1.127")
&ИсточникЗначение("192.168.1.42/32", "255.255.255.255", "192.168.1.42")
&ИсточникЗначение("::/0", "::", "ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff")
&ИсточникЗначение("2001:db8::/32", "ffff:ffff::", "2001:db8:ffff:ffff:ffff:ffff:ffff:ffff")
&ИсточникЗначение("2001:db8::/33", "ffff:ffff:8000::", "2001:db8:7fff:ffff:ffff:ffff:ffff:ffff")
&ИсточникЗначение("2001:db8::1/128", "ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff", "2001:db8::1")
Процедура ТестДолжен_ВернутьМаскуИГраницыДиапазона(Вход, ОжидаемаяМаска, ОжидаемыйПоследний) Экспорт

	// Подготовка
	Префикс = Новый IPПрефикс(Вход);

	// Действие
	Маска = Префикс.Маска();
	Первый = Префикс.ПервыйАдрес();
	Последний = Префикс.ПоследнийАдрес();

	// Проверка
	Ожидаем.Что(Маска.ВСтроку()).Равно(ОжидаемаяМаска);
	Ожидаем.Что(Первый.ВСтроку()).Равно(Префикс.БазовыйАдрес().ВСтроку());
	Ожидаем.Что(Последний.ВСтроку()).Равно(ОжидаемыйПоследний);
	Ожидаем.Что(Первый.ЕстьЗона()).ЭтоЛожь();
	Ожидаем.Что(Последний.ЕстьЗона()).ЭтоЛожь();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("192.168.1.42/32", 4, 32, 32, Истина)
&ИсточникЗначение("192.168.1.0/24", 4, 32, 24, Ложь)
&ИсточникЗначение("2001:db8::1/128", 6, 128, 128, Истина)
&ИсточникЗначение("2001:db8::/32", 6, 128, 32, Ложь)
Процедура ТестДолжен_ВернутьСемействоИДлинуПрефикса(
	Вход,
	Версия,
	ДлинаАдресаВБитах,
	ДлинаПрефикса,
	ОдинАдрес
) Экспорт

	// Действие
	Префикс = Новый IPПрефикс(Вход);

	// Проверка
	Ожидаем.Что(Префикс.Версия()).Равно(Версия);
	Ожидаем.Что(Префикс.ЭтоIPv4()).Равно(Версия = 4);
	Ожидаем.Что(Префикс.ЭтоIPv6()).Равно(Версия = 6);
	Ожидаем.Что(Префикс.ДлинаАдресаВБитах()).Равно(ДлинаАдресаВБитах);
	Ожидаем.Что(Префикс.ДлинаПрефикса()).Равно(ДлинаПрефикса);
	Ожидаем.Что(Префикс.ЭтоОдинАдрес()).Равно(ОдинАдрес);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНекорректнуюДлинуПриСозданииПрефиксаИзАдреса() Экспорт

	// Подготовка
	Адрес = Новый IPАдрес("192.168.1.42");

	// Действие и Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(
		ОшибкаПриСозданииПрефиксаИзАдреса(Адрес, "24"),
		КодыСтандартныхОшибок.НеверныйТипАргумента()
	);
	ПомощникТестированияIP.ПроверитьКодОшибки(
		ОшибкаПриСозданииПрефиксаИзАдреса(Адрес, 24.5),
		КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента()
	);
	ПомощникТестированияIP.ПроверитьКодОшибки(
		ОшибкаПриСозданииПрефиксаИзАдреса(Адрес, 33),
		КодыСтандартныхОшибок.АргументВнеДиапазона()
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаПриСозданииПрефиксаИзАдреса(Адрес, ДлинаПрефикса)

	Попытка
		Префикс = Адрес.Префикс(ДлинаПрефикса);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
