Процедура ТестДолжен_ОпределитьПринадлежностьАдресаПрефиксу(ТекстПрефикса, ТекстАдреса, Ожидание) Экспорт

	// Подготовка
	Префикс = Новый IPПрефикс(ТекстПрефикса);
	Адрес = Новый IPАдрес(ТекстАдреса);

	// Действие
	Результат = Префикс.Содержит(Адрес);

	// Проверка
	Ожидаем.Что(Результат).Равно(Ожидание);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНедопустимыйТипАдресаПриПроверкеПринадлежности() Экспорт

	// Подготовка
	Префикс = Новый IPПрефикс("192.0.2.0/24");

	// Действие
	Ошибка = ОшибкаПриПроверкеПринадлежности(Префикс, "192.0.2.1");

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(
		Ошибка,
		КодыСтандартныхОшибок.НеверныйТипАргумента()
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаПриПроверкеПринадлежности(Префикс, Адрес)

	Попытка
		Результат = Префикс.Содержит(Адрес);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
