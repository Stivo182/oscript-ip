#Область Тесты

&Тест
Процедура ТестДолжен_ЭкспортироватьСтабильныеКоды() Экспорт

	// Действие и Проверка
	Ожидаем.Что(КодыОшибокIP.НедопустимыйIPАдрес()).Равно("ip.invalid_address");
	Ожидаем.Что(КодыОшибокIP.НедопустимыйIPv4()).Равно("ip.invalid_ipv4");
	Ожидаем.Что(КодыОшибокIP.НедопустимыйIPv6()).Равно("ip.invalid_ipv6");
	Ожидаем.Что(КодыОшибокIP.НедопустимаяЗона()).Равно("ip.invalid_zone");
	Ожидаем.Что(КодыОшибокIP.ЗонаНедопустимаДляIPv4()).Равно("ip.zone_not_allowed_for_ipv4");
	Ожидаем.Что(КодыОшибокIP.НедопустимоеКоличествоОктетов()).Равно("ip.invalid_byte_length");
	Ожидаем.Что(КодыОшибокIP.НедопустимыйПрефикс()).Равно("ip.invalid_prefix");
	Ожидаем.Что(КодыОшибокIP.ДлинаПрефиксаВнеДиапазона()).Равно("ip.prefix_length_out_of_range");
	Ожидаем.Что(КодыОшибокIP.УстановленыБитыУзла()).Равно("ip.prefix.host_bits_set");
	Ожидаем.Что(КодыОшибокIP.НедопустимаяКонечнаяТочка()).Равно("ip.invalid_endpoint");
	Ожидаем.Что(КодыОшибокIP.ПортВнеДиапазона()).Равно("ip.port_out_of_range");
	Ожидаем.Что(КодыОшибокIP.НесовместимыеСемейства()).Равно("ip.family_mismatch");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьСтруктурированнуюОшибкуБезПричины() Экспорт

	// Подготовка
	Код = КодыОшибокIP.НедопустимыйIPАдрес();

	// Действие
	Ошибка = ОшибкиIP.Создать(Код, "Недопустимый IP-адрес");

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, Код);
	Снимок = ДиагностикаОшибок.НайтиПервую(Ошибка, Код);
	Ожидаем.Что(Снимок.Данные().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбернутьПричинуИСохранитьТолькоРазрешенныеДанные() Экспорт

	// Подготовка
	Причина = ФабрикаОшибок.Создать(КодыСтандартныхОшибок.ОперацияНедоступна(), "Исходная ошибка");
	Код = КодыОшибокIP.НедопустимыйIPv6();

	// Действие
	Ошибка = ОшибкиIP.Создать(Код, "Недопустимый IPv6", "Адрес", 7, "IPv6", Причина);

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, Код);
	Ожидаем.Что(Ошибка.Причина).Равно(Причина);
	Снимок = ДиагностикаОшибок.НайтиПервую(Ошибка, Код);
	Ожидаем.Что(Снимок.Данные().Компонент).Равно("Адрес");
	Ожидаем.Что(Снимок.Данные().Позиция).Равно(7);
	Ожидаем.Что(Снимок.Данные().Ожидание).Равно("IPv6");
	Ожидаем.Что(Снимок.Данные().Количество()).Равно(3);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСтруктурированнуюОшибкуРазбораIPv4() Экспорт

	// Действие
	Попытка
		Адрес = Новый IPАдрес("256.1.1.1");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, КодыОшибокIP.НедопустимыйIPv4());

КонецПроцедуры

#КонецОбласти
