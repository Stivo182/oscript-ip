#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("Адрес", "192.0.2.1", "192.0.2.1")
&ИсточникЗначение("Префикс", "192.0.2.0/24", "192.0.2.0/24")
&ИсточникЗначение("Сеть", "10.1.2.3/8", "10.0.0.0/8")
&ИсточникЗначение("Сеть", "2001:db8:1::1/32", "2001:db8::/32")
&ИсточникЗначение("КонечнаяТочка", "192.0.2.1:80", "192.0.2.1:80")
Процедура ТестДолжен_РазобратьКорректноеПредставление(Вид, Представление, Ожидаемое) Экспорт

	// Подготовка
	Ошибка = "старая ошибка";

	// Действие
	Результат = ПопытатьсяРазобрать(Вид, Представление, Ошибка);

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно(Ожидаемое);
	Ожидаем.Что(Ошибка).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Адрес", "999.0.2.1", "ip.invalid_ipv4")
&ИсточникЗначение("Префикс", "999.0.2.0/24", "ip.invalid_prefix")
&ИсточникЗначение("Сеть", "999.0.2.0/24", "ip.invalid_prefix")
&ИсточникЗначение("КонечнаяТочка", "999.0.2.1:80", "ip.invalid_endpoint")
Процедура ТестДолжен_ВернутьОшибкуДляНекорректногоПредставления(Вид, Представление, КодОшибки) Экспорт

	// Подготовка
	Ошибка = "старая ошибка";

	// Действие
	Результат = ПопытатьсяРазобрать(Вид, Представление, Ошибка);

	// Проверка
	Ожидаем.Что(Результат).Равно(Неопределено);
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, КодОшибки);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Адрес", "192.0.2.1", "192.0.2.1")
&ИсточникЗначение("Префикс", "192.0.2.0/24", "192.0.2.0/24")
&ИсточникЗначение("Сеть", "10.1.2.3/8", "10.0.0.0/8")
&ИсточникЗначение("КонечнаяТочка", "192.0.2.1:80", "192.0.2.1:80")
Процедура ТестДолжен_РазобратьПредставлениеБезПараметраОшибки(Вид, Представление, Ожидаемое) Экспорт

	// Действие
	Результат = ПопытатьсяРазобратьБезОшибки(Вид, Представление);

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно(Ожидаемое);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Адрес", "999.0.2.1")
&ИсточникЗначение("Префикс", "999.0.2.0/24")
&ИсточникЗначение("Сеть", "999.0.2.0/24")
&ИсточникЗначение("КонечнаяТочка", "999.0.2.1:80")
Процедура ТестДолжен_ВернутьНеопределеноБезПараметраОшибки(Вид, Представление) Экспорт

	// Действие
	Результат = ПопытатьсяРазобратьБезОшибки(Вид, Представление);

	// Проверка
	Ожидаем.Что(Результат).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Адрес")
&ИсточникЗначение("Префикс")
&ИсточникЗначение("Сеть")
&ИсточникЗначение("КонечнаяТочка")
Процедура ТестДолжен_ВыброситьИсключениеДляНеверногоТипаПредставления(Вид) Экспорт

	// Действие
	Ошибка = ОшибкаНеверногоТипа(Вид);

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, "argument.invalid_type");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("192.168.1.0")
&ИсточникЗначение("192.168.1.0/01")
&ИсточникЗначение("192.168.1.0/24/1")
&ИсточникЗначение("fe80::%eth0/64")
Процедура ТестДолжен_ОтклонитьНекорректныйСинтаксисСети(Представление) Экспорт

	// Подготовка
	Ошибка = Неопределено;

	// Действие
	Результат = РазборIP.ПопытатьсяРазобратьСеть(Представление, Ошибка);

	// Проверка
	Ожидаем.Что(Результат).Равно(Неопределено);
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, "ip.invalid_prefix");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("192.168.1.0/33")
&ИсточникЗначение("2001:db8::/129")
Процедура ТестДолжен_ОтклонитьДлинуСетиВнеДиапазона(Представление) Экспорт

	// Подготовка
	Ошибка = Неопределено;

	// Действие
	Результат = РазборIP.ПопытатьсяРазобратьСеть(Представление, Ошибка);

	// Проверка
	Ожидаем.Что(Результат).Равно(Неопределено);
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, "ip.prefix_length_out_of_range");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПопытатьсяРазобрать(Вид, Представление, Ошибка)

	Если Вид = "Адрес" Тогда
		Возврат РазборIP.ПопытатьсяРазобратьАдрес(Представление, Ошибка);
	ИначеЕсли Вид = "Префикс" Тогда
		Возврат РазборIP.ПопытатьсяРазобратьПрефикс(Представление, Ошибка);
	ИначеЕсли Вид = "Сеть" Тогда
		Возврат РазборIP.ПопытатьсяРазобратьСеть(Представление, Ошибка);
	Иначе
		Возврат РазборIP.ПопытатьсяРазобратьКонечнуюТочку(Представление, Ошибка);
	КонецЕсли;

КонецФункции

Функция ПопытатьсяРазобратьБезОшибки(Вид, Представление)

	Если Вид = "Адрес" Тогда
		Возврат РазборIP.ПопытатьсяРазобратьАдрес(Представление);
	ИначеЕсли Вид = "Префикс" Тогда
		Возврат РазборIP.ПопытатьсяРазобратьПрефикс(Представление);
	ИначеЕсли Вид = "Сеть" Тогда
		Возврат РазборIP.ПопытатьсяРазобратьСеть(Представление);
	Иначе
		Возврат РазборIP.ПопытатьсяРазобратьКонечнуюТочку(Представление);
	КонецЕсли;

КонецФункции

Функция ОшибкаНеверногоТипа(Вид)

	Попытка
		Ошибка = Неопределено;
		ПопытатьсяРазобрать(Вид, 42, Ошибка);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
