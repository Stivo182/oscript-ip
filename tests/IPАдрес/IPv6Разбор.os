#Область Тесты

&Тест
Процедура ТестДолжен_РазобратьIPv6ПарсеромКакКлассом() Экспорт

	// Подготовка
	Парсер = Новый ПарсерIPv6Адресов();

	// Действие
	ДанныеАдреса = Парсер.Разобрать("2001:db8::1");

	// Проверка
	Ожидаем.Что(ДанныеАдреса.Октеты.Количество()).Равно(16);
	Ожидаем.Что(ДанныеАдреса.Октеты[0]).Равно(32);
	Ожидаем.Что(ДанныеАдреса.Октеты[1]).Равно(1);
	Ожидаем.Что(ДанныеАдреса.Октеты[15]).Равно(1);
	Ожидаем.Что(ДанныеАдреса.Зона).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("::")
&ИсточникЗначение("::1")
&ИсточникЗначение("2001:0db8:0000:0000:0000:0000:0000:0001")
&ИсточникЗначение("2001:db8::1")
&ИсточникЗначение("::2001:db8:0:0:0:1")
&ИсточникЗначение("2001:db8:0:0:0:1::")
&ИсточникЗначение("2001:DB8::1")
&ИсточникЗначение("::ffff:192.0.2.1")
&ИсточникЗначение("0:0:0:0:0:ffff:192.0.2.1")
&ИсточникЗначение("fe80::1%eth0")
&ИсточникЗначение("fe80::1%7")
&ИсточникЗначение("fe80::1% ")
Процедура ТестДолжен_РазобратьКорректныйIPv6ПоRFC4291(Представление) Экспорт

	// Подготовка
	Данные = ОжидаемыеДанныеIPv6(Представление);

	// Действие
	Адрес = Новый IPАдрес(Представление);

	// Проверка
	Ожидаем.Что(
		ПолучитьHexСтрокуИзДвоичныхДанных(Адрес.ДвоичныеДанные())
	).Равно(Данные.Октеты);
	Ожидаем.Что(Адрес.Зона()).Равно(Данные.Зона);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПричинуIPv4ВОшибкеIPv6() Экспорт

	// Действие
	Ошибка = ОшибкаПриСозданииАдреса("::ffff:192.168.001.1");

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(
		Ошибка,
		КодыОшибокIP.НедопустимыйIPv6()
	);
	КодIPv4 = КодыОшибокIP.НедопустимыйIPv4();
	СодержитIPv4 = ДиагностикаОшибок.Содержит(Ошибка, КодIPv4);
	Ожидаем.Что(СодержитIPv4).ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("[::1]")
&ИсточникЗначение("1::2::3")
&ИсточникЗначение("2001:db8:::1")
&ИсточникЗначение("gggg")
&ИсточникЗначение("1:2:3:4:5:6:7:8:9")
&ИсточникЗначение("1:2:3:4:5:6:7")
&ИсточникЗначение("1:192.0.2.1::")
&ИсточникЗначение("::ffff:192.168.001.1")
&ИсточникЗначение("::ffff:256.1.1.1")
Процедура ТестДолжен_ОтклонитьНекорректныйIPv6ПоRFC4291(Представление) Экспорт

	// Действие
	Ошибка = ОшибкаПриСозданииАдреса(Представление);

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(
		Ошибка,
		КодыОшибокIP.НедопустимыйIPv6()
	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("fe80::1%")
&ИсточникЗначение("fe80::1%eth0%2")
&ИсточникЗначение("fe80::1%[eth0]")
Процедура ТестДолжен_ОбернутьНекорректнуюТекстовуюЗонуВОшибкуIPv6(Представление) Экспорт

	// Действие
	Ошибка = ОшибкаПриСозданииАдреса(Представление);

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(
		Ошибка,
		КодыОшибокIP.НедопустимыйIPv6()
	);
	Ожидаем.Что(
		ДиагностикаОшибок.Содержит(Ошибка, КодыОшибокIP.НедопустимаяЗона())
	).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбернутьДинамическиНекорректныеТекстовыеЗоныВОшибкуIPv6() Экспорт

	// Подготовка
	НекорректныеЗоны = Новый Массив;
	НекорректныеЗоны.Добавить(Символ(0));
	НекорректныеЗоны.Добавить(Символы.ВК);
	НекорректныеЗоны.Добавить(Символы.ПС);

	// Действие и Проверка
	Для Каждого Зона Из НекорректныеЗоны Цикл
		Ошибка = ОшибкаПриСозданииАдреса("fe80::1%" + Зона);
		ПомощникТестированияIP.ПроверитьКодОшибки(
			Ошибка,
			КодыОшибокIP.НедопустимыйIPv6()
		);
		Ожидаем.Что(
			ДиагностикаОшибок.Содержит(Ошибка, КодыОшибокIP.НедопустимаяЗона())
		).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобавитьОжидаемыйФорматВОшибкуIPv6() Экспорт

	// Действие
	Ошибка = ОшибкаПриСозданииАдреса("2001:db8::g");

	// Проверка
	КодОшибки = КодыОшибокIP.НедопустимыйIPv6();
	Снимок = ДиагностикаОшибок.НайтиПервую(Ошибка, КодОшибки);
	Ожидаем.Что(Снимок.Данные().Компонент).Равно("Адрес");
	Ожидаем.Что(Снимок.Данные().Ожидание).Равно("IPv6 по RFC 4291");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОжидаемыеДанныеIPv6(Представление)

	Октеты = Неопределено;
	Зона = Неопределено;
	Если Представление = "::" Тогда
		Октеты = "00000000000000000000000000000000";
	ИначеЕсли Представление = "::1" Тогда
		Октеты = "00000000000000000000000000000001";
	ИначеЕсли Представление = "2001:0db8:0000:0000:0000:0000:0000:0001"
		Или Представление = "2001:db8::1"
		Или Представление = "2001:DB8::1" Тогда
		Октеты = "20010DB8000000000000000000000001";
	ИначеЕсли Представление = "::2001:db8:0:0:0:1" Тогда
		Октеты = "0000000020010DB80000000000000001";
	ИначеЕсли Представление = "2001:db8:0:0:0:1::" Тогда
		Октеты = "20010DB8000000000000000100000000";
	ИначеЕсли Представление = "::ffff:192.0.2.1"
		Или Представление = "0:0:0:0:0:ffff:192.0.2.1" Тогда
		Октеты = "00000000000000000000FFFFC0000201";
	ИначеЕсли Представление = "fe80::1%eth0" Тогда
		Октеты = "FE800000000000000000000000000001";
		Зона = "eth0";
	ИначеЕсли Представление = "fe80::1%7" Тогда
		Октеты = "FE800000000000000000000000000001";
		Зона = "7";
	ИначеЕсли Представление = "fe80::1% " Тогда
		Октеты = "FE800000000000000000000000000001";
		Зона = " ";
	КонецЕсли;

	Возврат Новый Структура("Октеты,Зона", Октеты, Зона);

КонецФункции

Функция ОшибкаПриСозданииАдреса(Представление)

	Попытка
		Адрес = Новый IPАдрес(Представление);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
