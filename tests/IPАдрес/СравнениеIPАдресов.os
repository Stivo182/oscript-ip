#Область Тесты

&Тест
Процедура ТестДолжен_СравниватьСтрокиПоКодамСимволовСУчетомРегистра() Экспорт

	// Действие и Проверка
	Ожидаем.Что(IPБиты.СравнитьСтрокиПоКодамСимволов("ETH0", "eth0")).Равно(-1);
	Ожидаем.Что(IPБиты.СравнитьСтрокиПоКодамСимволов("eth", "eth0")).Равно(-1);
	Ожидаем.Что(IPБиты.СравнитьСтрокиПоКодамСимволов("я", "ё")).Равно(-1);
	Ожидаем.Что(IPБиты.СравнитьСтрокиПоКодамСимволов("eth0", "eth0")).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьОдинаковыеАдресаРавными() Экспорт

	// Подготовка
	ПервыйАдрес = Новый IPАдрес("fe80:0:0:0:0:0:0:1%eth0");
	ВторойАдрес = Новый IPАдрес("fe80::1%eth0");

	// Действие
	Результат = ПервыйАдрес.Равно(ВторойАдрес);

	// Проверка
	Ожидаем.Что(Результат).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазличатьСостояниеИСтрокуЗоныПриРавенстве() Экспорт

	// Подготовка
	АдресБезЗоны = Новый IPАдрес("fe80::1");
	АдресВВерхнемРегистре = Новый IPАдрес("fe80::1%ETH0");
	АдресВНижнемРегистре = Новый IPАдрес("fe80::1%eth0");

	// Действие и Проверка
	Ожидаем.Что(АдресБезЗоны.Равно(АдресВНижнемРегистре)).ЭтоЛожь();
	Ожидаем.Что(АдресВВерхнемРегистре.Равно(АдресВНижнемРегистре)).ЭтоЛожь();
	Ожидаем.Что(АдресВВерхнемРегистре.РавноБезУчетаЗоны(АдресВНижнемРегистре)).ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("192.0.2.1", "::", -1)
&ИсточникЗначение("::", "192.0.2.1", 1)
&ИсточникЗначение("192.0.2.1", "192.0.2.2", -1)
&ИсточникЗначение("2001:db8::2", "2001:db8::1", 1)
&ИсточникЗначение("fe80::1", "fe80::1%eth0", -1)
&ИсточникЗначение("fe80::1%ETH0", "fe80::1%eth0", -1)
&ИсточникЗначение("fe80::1%eth0", "fe80::1%eth", 1)
&ИсточникЗначение("fe80::1%я", "fe80::1%ё", -1)
&ИсточникЗначение("fe80::1%eth0", "fe80::1%eth0", 0)
Процедура ТестДолжен_СравниватьАдресаВДетерминированномПорядке(Первый, Второй, ОжидаемыйРезультат) Экспорт

	// Действие
	Результат = Новый IPАдрес(Первый).Сравнить(Новый IPАдрес(Второй));

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемыйРезультат);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНедопустимыйТипДругогоАдресаПриРавенстве() Экспорт

	// Подготовка
	Адрес = Новый IPАдрес("192.0.2.1");

	// Действие
	Ошибка = ОшибкаПриСравненииНаРавенство(Адрес, "192.0.2.1");

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(
		Ошибка,
		КодыСтандартныхОшибок.НеверныйТипАргумента()
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНедопустимыйТипДругогоАдресаПриРавенствеБезУчетаЗоны() Экспорт

	// Подготовка
	Адрес = Новый IPАдрес("192.0.2.1");

	// Действие
	Ошибка = ОшибкаПриСравненииБезУчетаЗоны(Адрес, "192.0.2.1");

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(
		Ошибка,
		КодыСтандартныхОшибок.НеверныйТипАргумента()
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНедопустимыйТипДругогоАдресаПриСравнении() Экспорт

	// Подготовка
	Адрес = Новый IPАдрес("192.0.2.1");

	// Действие
	Ошибка = ОшибкаПриУпорядочивающемСравнении(Адрес, "192.0.2.1");

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(
		Ошибка,
		КодыСтандартныхОшибок.НеверныйТипАргумента()
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаПриСравненииНаРавенство(Адрес, Другой)

	Попытка
		Результат = Адрес.Равно(Другой);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ОшибкаПриСравненииБезУчетаЗоны(Адрес, Другой)

	Попытка
		Результат = Адрес.РавноБезУчетаЗоны(Другой);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ОшибкаПриУпорядочивающемСравнении(Адрес, Другой)

	Попытка
		Результат = Адрес.Сравнить(Другой);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
