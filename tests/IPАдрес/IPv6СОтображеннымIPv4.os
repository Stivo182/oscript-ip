#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("::ffff:192.0.2.1")
&ИсточникЗначение("::ffff:c000:201")
&ИсточникЗначение("0:0:0:0:0:ffff:192.0.2.1")
Процедура ТестДолжен_РаспознаватьIPv6СОтображеннымIPv4(Вход) Экспорт

	// Действие
	Адрес = Новый IPАдрес(Вход);

	// Проверка
	Ожидаем.Что(Адрес.ЭтоIPv6СОтображеннымIPv4()).ЭтоИстина();
	Ожидаем.Что(Адрес.ВСтроку()).Равно("::ffff:192.0.2.1");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("::ffff:192.0.2.1", Истина)
&ИсточникЗначение("2001:db8::1", Ложь)
Процедура ТестДолжен_РаспознаватьОтображенныйIPv4ПоБитам(Вход, Ожидаемое) Экспорт

	// Подготовка
	Октеты = Новый IPАдрес(Вход).Октеты();

	// Действие
	Результат = ОперацииСОктетамиIPАдресов.ЭтоIPv6СОтображеннымIPv4(Октеты);

	// Проверка
	Ожидаем.Что(Результат).Равно(Ожидаемое);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПреобразоватьIPv4ВIPv6СОтображеннымIPv4() Экспорт

	// Действие
	Результат = Новый IPАдрес("192.0.2.1").IPv6();

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно("::ffff:192.0.2.1");
	Ожидаем.Что(Результат.ИмеетЗону()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПреобразоватьIPv6СОтображеннымIPv4ВIPv4() Экспорт

	// Подготовка
	Адрес = Новый IPАдрес("::ffff:192.0.2.1");

	// Действие
	Результат = Адрес.IPv4();

	// Проверка
	Ожидаем.Что(Результат.ВСтроку()).Равно("192.0.2.1");
	Ожидаем.Что(Результат.ИмеетЗону()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеопределеноДляОбычногоIPv6ПриПолученииIPv4() Экспорт

	// Действие
	Результат = Новый IPАдрес("2001:db8::1").IPv4();

	// Проверка
	Ожидаем.Что(Результат).Равно(Неопределено);

КонецПроцедуры

#КонецОбласти
