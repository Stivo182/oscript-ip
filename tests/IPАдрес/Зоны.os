#Область Тесты

&Тест
Процедура ТестДолжен_СохранитьЗонуIPv6Буквально() Экспорт

	// Подготовка
	ОжидаемаяЗона = " интерфейс Ж";

	// Действие
	Адрес = Новый IPАдрес("fe80::1%" + ОжидаемаяЗона);

	// Проверка
	Ожидаем.Что(Адрес.ЕстьЗона()).ЭтоИстина();
	Ожидаем.Что(Адрес.Зона()).Равно(ОжидаемаяЗона);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьЗонуIPv6ИзОдногоПробела() Экспорт

	// Действие
	Адрес = Новый IPАдрес("fe80::1").СЗоной(" ");

	// Проверка
	Ожидаем.Что(Адрес.Зона()).Равно(" ");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьIPv6АдресСЗонойИБезЗоны() Экспорт

	// Подготовка
	ИсходныйАдрес = Новый IPАдрес("fe80::1");

	// Действие
	АдресСЗоной = ИсходныйАдрес.СЗоной("eth0");
	АдресБезЗоны = АдресСЗоной.БезЗоны();

	// Проверка
	Ожидаем.Что(ИсходныйАдрес.ЕстьЗона()).ЭтоЛожь();
	Ожидаем.Что(АдресСЗоной.Зона()).Равно("eth0");
	Ожидаем.Что(АдресБезЗоны.ЕстьЗона()).ЭтоЛожь();
	ДанныеИсходногоАдреса = ИсходныйАдрес.ДвоичныеДанные();
	ШестнадцатеричнаяСтрока = ПолучитьHexСтрокуИзДвоичныхДанных(ДанныеИсходногоАдреса);
	БайтыИсходногоАдреса = ШестнадцатеричнаяСтрока;
	Ожидаем.Что(БайтыИсходногоАдреса)
		.Равно(ПолучитьHexСтрокуИзДвоичныхДанных(АдресСЗоной.ДвоичныеДанные()));
	Ожидаем.Что(БайтыИсходногоАдреса)
		.Равно(ПолучитьHexСтрокуИзДвоичныхДанных(АдресБезЗоны.ДвоичныеДанные()));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("2001:db8::1")
&ИсточникЗначение("::")
&ИсточникЗначение("::1")
&ИсточникЗначение("ff0e::1")
Процедура ТестДолжен_ОтклонитьЗонуДляIPv6БезОграниченнойОбласти(Представление) Экспорт

	// Подготовка
	Адрес = Новый IPАдрес(Представление);

	// Действие
	Ошибка = ОшибкаПриУстановкеЗоны(Адрес, "eth0");

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, КодыОшибокIP.НедопустимаяЗона());

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьЗонуДляIPv6ГрупповойОграниченнойОбласти() Экспорт

	// Действие
	Адрес = Новый IPАдрес("ff02::1%eth0");

	// Проверка
	Ожидаем.Что(Адрес.Зона()).Равно("eth0");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНекорректнуюЗонуIPv4() Экспорт

	// Подготовка
	IPv6 = Новый IPАдрес("fe80::1");
	IPv4 = Новый IPАдрес("192.0.2.1");

	// Действие и Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(
		ОшибкаПриУстановкеЗоны(IPv6, ""),
		КодыОшибокIP.НедопустимаяЗона()
	);
	ПомощникТестированияIP.ПроверитьКодОшибки(
		ОшибкаПриУстановкеЗоны(IPv6, "eth0%2"),
		КодыОшибокIP.НедопустимаяЗона()
	);
	ПомощникТестированияIP.ПроверитьКодОшибки(
		ОшибкаПриУстановкеЗоны(IPv6, 7),
		КодыСтандартныхОшибок.НеверныйТипАргумента()
	);
	ПомощникТестированияIP.ПроверитьКодОшибки(
		ОшибкаПриУстановкеЗоны(IPv4, "eth0"),
		КодыОшибокIP.ЗонаНедопустимаДляIPv4()
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаПриУстановкеЗоны(Адрес, Зона)

	Попытка
		АдресСЗоной = Адрес.СЗоной(Зона);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
