#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("2001:db8::/32", "2001:db8:c000:221::")
&ИсточникЗначение("2001:db8:100::/40", "2001:db8:1c0:2:21::")
&ИсточникЗначение("2001:db8:122::/48", "2001:db8:122:c000:2:2100::")
&ИсточникЗначение("2001:db8:122:300::/56", "2001:db8:122:3c0:0:221::")
&ИсточникЗначение("2001:db8:122:344::/64", "2001:db8:122:344:c0:2:2100:0")
&ИсточникЗначение("2001:db8:122:344::/96", "2001:db8:122:344::c000:221")
Процедура ТестДолжен_ПреобразоватьIPv4ПоПрефиксуRFC6052(ТекстПрефикса, ОжидаемыйIPv6) Экспорт

	// Подготовка
	IPv4 = Новый IPАдрес("192.0.2.33");
	Префикс = Новый IPПрефикс(ТекстПрефикса);

	// Действие
	IPv6 = IPv4.IPv6(Префикс);
	ОбратноеПреобразование = IPv6.IPv4(Префикс);

	// Проверка
	Ожидаем.Что(IPv6.ВСтроку()).Равно(ОжидаемыйIPv6);
	Ожидаем.Что(IPv6.ИмеетЗону()).ЭтоЛожь();
	Ожидаем.Что(ОбратноеПреобразование.Равно(IPv4)).ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("64:ff9b::/96", "64:ff9b::a9fe:a9fe", "169.254.169.254")
&ИсточникЗначение("64:ff9b:1:100::/64", "64:ff9b:1:100:c0:2:2100:0", "192.0.2.33")
&ИсточникЗначение("::/96", "::7f00:1", "127.0.0.1")
Процедура ТестДолжен_ИзвлечьIPv4ИзПрактическихПрефиксов(ТекстПрефикса, ТекстIPv6, ОжидаемыйIPv4) Экспорт

	// Подготовка
	Префикс = Новый IPПрефикс(ТекстПрефикса);
	IPv6 = Новый IPАдрес(ТекстIPv6);

	// Действие
	IPv4 = IPv6.IPv4(Префикс);

	// Проверка
	Ожидаем.Что(IPv4.ВСтроку()).Равно(ОжидаемыйIPv4);
	Ожидаем.Что(IPv4.ИмеетЗону()).ЭтоЛожь();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("2001:db8:122:344:1c0:2:2100::")
&ИсточникЗначение("2001:db8:122:344:c0:2:2100:1")
Процедура ТестДолжен_ИгнорироватьОктетUИСуффиксПриИзвлеченииIPv4(ТекстIPv6) Экспорт

	// Подготовка
	Префикс = Новый IPПрефикс("2001:db8:122:344::/64");

	// Действие
	IPv4 = Новый IPАдрес(ТекстIPv6).IPv4(Префикс);

	// Проверка
	Ожидаем.Что(IPv4.ВСтроку()).Равно("192.0.2.33");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеопределеноДляАдресаВнеПрефикса() Экспорт

	// Подготовка
	Префикс = Новый IPПрефикс("64:ff9b::/96");

	// Действие
	IPv4 = Новый IPАдрес("2001:db8::a9fe:a9fe").IPv4(Префикс);

	// Проверка
	Ожидаем.Что(IPv4).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПоведениеПриЯвномНеопределено() Экспорт

	// Подготовка
	IPv4 = Новый IPАдрес("192.0.2.33");
	ОтображенныйIPv4 = Новый IPАдрес("::ffff:192.0.2.33");

	// Действие
	IPv6БезАргумента = IPv4.IPv6();
	IPv6СНеопределено = IPv4.IPv6(Неопределено);
	IPv4БезАргумента = ОтображенныйIPv4.IPv4();
	IPv4СНеопределено = ОтображенныйIPv4.IPv4(Неопределено);

	// Проверка
	Ожидаем.Что(IPv6СНеопределено.Равно(IPv6БезАргумента)).ЭтоИстина();
	Ожидаем.Что(IPv4СНеопределено.Равно(IPv4БезАргумента)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьКопиюАдресаЦелевогоСемейства() Экспорт

	// Подготовка
	Префикс = Новый IPПрефикс("64:ff9b::/96");
	IPv4 = Новый IPАдрес("192.0.2.33");
	IPv6 = Новый IPАдрес("fe80::1%eth0");

	// Действие
	РезультатIPv4 = IPv4.IPv4(Префикс);
	РезультатIPv6 = IPv6.IPv6(Префикс);

	// Проверка
	Ожидаем.Что(РезультатIPv4.Равно(IPv4)).ЭтоИстина();
	Ожидаем.Что(РезультатIPv6.Равно(IPv6)).ЭтоИстина();
	Ожидаем.Что(РезультатIPv6.Зона()).Равно("eth0");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("строка")
&ИсточникЗначение(7)
&ИсточникЗначение(Null)
Процедура ТестДолжен_ОтклонитьНедопустимыйТипПрефикса(Префикс) Экспорт

	// Подготовка
	IPv4 = Новый IPАдрес("192.0.2.33");
	IPv6 = Новый IPАдрес("2001:db8::1");

	// Действие
	ОшибкаIPv4 = ОшибкаПриПолученииIPv4(IPv6, Префикс);
	ОшибкаIPv6 = ОшибкаПриПолученииIPv6(IPv4, Префикс);

	// Проверка
	КодОшибки = КодыСтандартныхОшибок.НеверныйТипАргумента();
	ПомощникТестированияIP.ПроверитьКодОшибки(ОшибкаIPv4, КодОшибки);
	ПомощникТестированияIP.ПроверитьКодОшибки(ОшибкаIPv6, КодОшибки);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьIPv4ПрефиксДляОбоихНаправлений() Экспорт

	// Подготовка
	Префикс = Новый IPПрефикс("192.0.2.0/24");
	IPv4 = Новый IPАдрес("192.0.2.33");
	IPv6 = Новый IPАдрес("2001:db8::1");

	// Действие
	ОшибкаIPv4 = ОшибкаПриПолученииIPv4(IPv6, Префикс);
	ОшибкаIPv6 = ОшибкаПриПолученииIPv6(IPv4, Префикс);

	// Проверка
	ПроверитьНедопустимоеЗначениеПрефикса(ОшибкаIPv4);
	ПроверитьНедопустимоеЗначениеПрефикса(ОшибкаIPv6);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьПрефиксДоВозвратаКопии() Экспорт

	// Подготовка
	IPv4Префикс = Новый IPПрефикс("192.0.2.0/24");
	НедопустимаяДлина = Новый IPПрефикс("2001:db8::/33");
	IPv4 = Новый IPАдрес("192.0.2.33");
	IPv6 = Новый IPАдрес("2001:db8::1");

	// Действие
	ОшибкаIPv4 = ОшибкаПриПолученииIPv4(IPv4, IPv4Префикс);
	ОшибкаIPv6 = ОшибкаПриПолученииIPv6(IPv6, НедопустимаяДлина);

	// Проверка
	ПроверитьНедопустимоеЗначениеПрефикса(ОшибкаIPv4);
	ПроверитьНедопустимоеЗначениеПрефикса(ОшибкаIPv6);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьВсеНеподдерживаемыеДлиныПрефикса() Экспорт

	// Подготовка
	IPv4 = Новый IPАдрес("192.0.2.33");
	БазовыйIPv6 = Новый IPАдрес("::");

	// Действие и Проверка
	Для ДлинаПрефикса = 0 По 128 Цикл
		Если ЭтоДопустимаяДлинаПрефикса(ДлинаПрефикса) Тогда
			Продолжить;
		КонецЕсли;

		Префикс = Новый IPПрефикс(БазовыйIPv6, ДлинаПрефикса);
		Ошибка = ОшибкаПриПолученииIPv6(IPv4, Префикс);
		ПроверитьНедопустимоеЗначениеПрефикса(Ошибка);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьПрефикс96СНенулевымОктетомU() Экспорт

	// Подготовка
	Префикс = Новый IPПрефикс("2001:db8:0:0:100:0::/96");
	IPv4 = Новый IPАдрес("192.0.2.33");

	// Действие
	Ошибка = ОшибкаПриПолученииIPv6(IPv4, Префикс);

	// Проверка
	ПроверитьНедопустимоеЗначениеПрефикса(Ошибка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаПриПолученииIPv4(Адрес, Префикс)

	Попытка
		Результат = Адрес.IPv4(Префикс);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ОшибкаПриПолученииIPv6(Адрес, Префикс)

	Попытка
		Результат = Адрес.IPv6(Префикс);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Процедура ПроверитьНедопустимоеЗначениеПрефикса(Ошибка)

	ПомощникТестированияIP.ПроверитьКодОшибки(
		Ошибка,
		КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента()
	);

КонецПроцедуры

Функция ЭтоДопустимаяДлинаПрефикса(ДлинаПрефикса)

	Возврат ДлинаПрефикса = 32
		Или ДлинаПрефикса = 40
		Или ДлинаПрефикса = 48
		Или ДлинаПрефикса = 56
		Или ДлинаПрефикса = 64
		Или ДлинаПрефикса = 96;

КонецФункции

#КонецОбласти
