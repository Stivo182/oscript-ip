&Тест
Процедура ТестДолжен_ОтклонитьНедопустимыйОктет() Экспорт

	// Действие и Проверка
	ПроверитьНедопустимыйОктет("строка", "argument.invalid_type");
	ПроверитьНедопустимыйОктет(1.5, "argument.invalid_value");
	ПроверитьНедопустимыйОктет(-1, "argument.out_of_range");
	ПроверитьНедопустимыйОктет(256, "argument.out_of_range");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьNullКакОктет() Экспорт

	// Подготовка
	Октеты = Новый Массив;
	Октеты.Добавить(Null);
	Октеты.Добавить(0);
	Октеты.Добавить(2);
	Октеты.Добавить(1);

	// Действие
	КодОшибки = КодИсключенияПриСозданииАдреса(Октеты);

	// Проверка
	Ожидаем.Что(КодОшибки).Равно("argument.invalid_type");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьNullКакВходКонструктора() Экспорт

	// Действие
	КодОшибки = КодИсключенияПриСозданииАдреса(Null);

	// Проверка
	Ожидаем.Что(КодОшибки).Равно("argument.invalid_type");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КодИсключенияПриСозданииАдреса(Значение)

	Попытка
		Адрес = Новый IPАдрес(Значение);
	Исключение
		Возврат ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат "исключение отсутствует";

КонецФункции

Процедура ПроверитьНедопустимуюДлинуМассиваОктетов(Длина)

	Октеты = Новый Массив;
	Для Индекс = 1 По Длина Цикл
		Октеты.Добавить(0);
	КонецЦикла;

	Ожидаем.Что(КодИсключенияПриСозданииАдреса(Октеты)).Равно("ip.invalid_byte_length");

КонецПроцедуры

Процедура ПроверитьНедопустимуюДлинуДвоичныхДанных(Длина)

	// Подготовка
	Hex = "";
	Для Индекс = 1 По Длина Цикл
		Hex = Hex + "00";
	КонецЦикла;
	Данные = ПолучитьДвоичныеДанныеИзHexСтроки(Hex);

	// Действие
	КодОшибки = КодИсключенияПриСозданииАдреса(Данные);

	// Проверка
	Ожидаем.Что(КодОшибки).Равно("ip.invalid_byte_length");

КонецПроцедуры

Процедура ПроверитьНедопустимыйОктет(Октет, ОжидаемыйКодОшибки)

	Октеты = Новый Массив;
	Октеты.Добавить(Октет);
	Октеты.Добавить(0);
	Октеты.Добавить(2);
	Октеты.Добавить(1);

	Ожидаем.Что(КодИсключенияПриСозданииАдреса(Октеты)).Равно(ОжидаемыйКодОшибки);

КонецПроцедуры

#КонецОбласти
