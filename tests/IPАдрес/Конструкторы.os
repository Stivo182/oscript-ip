#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьIPv4ИзМассиваОктетов() Экспорт

	// Подготовка
	Октеты = Новый Массив;
	Октеты.Добавить(192);
	Октеты.Добавить(0);
	Октеты.Добавить(2);
	Октеты.Добавить(1);

	// Действие
	Адрес = Новый IPАдрес(Октеты);

	// Проверка
	Ожидаем.Что(Адрес.Версия()).Равно(4);
	Ожидаем.Что(Адрес.ЭтоIPv4()).ЭтоИстина();
	Ожидаем.Что(Адрес.ЭтоIPv6()).ЭтоЛожь();
	Ожидаем.Что(Адрес.ДлинаВБитах()).Равно(32);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьIPv6ИзФиксированногоМассиваОктетов() Экспорт

	// Подготовка
	Октеты = Новый Массив;
	Для Индекс = 1 По 16 Цикл
		Октеты.Добавить(Индекс);
	КонецЦикла;

	// Действие
	Адрес = Новый IPАдрес(Новый ФиксированныйМассив(Октеты));

	// Проверка
	Ожидаем.Что(Адрес.Версия()).Равно(6);
	Ожидаем.Что(Адрес.ЭтоIPv4()).ЭтоЛожь();
	Ожидаем.Что(Адрес.ЭтоIPv6()).ЭтоИстина();
	Ожидаем.Что(Адрес.ДлинаВБитах()).Равно(128);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеЗависетьОтИзмененияИсходногоМассива() Экспорт

	// Подготовка
	Октеты = Новый Массив;
	Октеты.Добавить(192);
	Октеты.Добавить(0);
	Октеты.Добавить(2);
	Октеты.Добавить(1);
	Адрес = Новый IPАдрес(Октеты);

	// Действие
	Октеты[0] = 127;

	// Проверка
	Ожидаем.Что(ПолучитьHexСтрокуИзДвоичныхДанных(Адрес.Байты())).Равно("C0000201");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СкопироватьСостояниеДругогоАдреса() Экспорт

	// Подготовка
	ИсходныйАдрес = Новый IPАдрес(ПолучитьДвоичныеДанныеИзHexСтроки("C0000201"));

	// Действие
	Копия = Новый IPАдрес(ИсходныйАдрес);

	// Проверка
	Ожидаем.Что(Копия.Версия()).Равно(ИсходныйАдрес.Версия());
	Ожидаем.Что(ПолучитьHexСтрокуИзДвоичныхДанных(Копия.Байты()))
		.Равно(ПолучитьHexСтрокуИзДвоичныхДанных(ИсходныйАдрес.Байты()));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНедопустимуюДлинуМассиваОктетов() Экспорт

	// Действие и Проверка
	ПроверитьНедопустимуюДлинуМассиваОктетов(0);
	ПроверитьНедопустимуюДлинуМассиваОктетов(3);
	ПроверитьНедопустимуюДлинуМассиваОктетов(5);
	ПроверитьНедопустимуюДлинуМассиваОктетов(15);
	ПроверитьНедопустимуюДлинуМассиваОктетов(17);

КонецПроцедуры

