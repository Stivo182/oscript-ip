&Тест
Процедура ТестДолжен_ОтклонитьНедопустимыйОктет() Экспорт

	// Действие и Проверка
	ПроверитьНедопустимыйОктет("строка", КодыСтандартныхОшибок.НеверныйТипАргумента());
	ПроверитьНедопустимыйОктет(1.5, КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента());
	ПроверитьНедопустимыйОктет(-1, КодыСтандартныхОшибок.АргументВнеДиапазона());
	ПроверитьНедопустимыйОктет(256, КодыСтандартныхОшибок.АргументВнеДиапазона());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьNullКакОктет() Экспорт

	// Подготовка
	Октеты = Новый Массив;
	Октеты.Добавить(Null);
	Октеты.Добавить(0);
	Октеты.Добавить(2);
	Октеты.Добавить(1);

	// Действие
	КодОшибки = КодИсключенияПриСозданииАдреса(Октеты);

	// Проверка
	Ожидаем.Что(КодОшибки).Равно(КодыСтандартныхОшибок.НеверныйТипАргумента());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьNullКакВходКонструктора() Экспорт

	// Действие
	КодОшибки = КодИсключенияПриСозданииАдреса(Null);

	// Проверка
	Ожидаем.Что(КодОшибки).Равно(КодыСтандартныхОшибок.НеверныйТипАргумента());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КодИсключенияПриСозданииАдреса(Значение)

	Попытка
		Адрес = Новый IPАдрес(Значение);
	Исключение
		Возврат ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат "исключение отсутствует";

КонецФункции

Процедура ПроверитьНедопустимуюДлинуМассиваОктетов(Длина)

	Октеты = Новый Массив;
	Для Индекс = 1 По Длина Цикл
		Октеты.Добавить(0);
	КонецЦикла;

	Ожидаем.Что(КодИсключенияПриСозданииАдреса(Октеты))
		.Равно(КодыОшибокIP.НедопустимаяДлинаБайтов());

КонецПроцедуры

Процедура ПроверитьНедопустимуюДлинуДвоичныхДанных(Длина)

	// Подготовка
	ШестнадцатеричнаяСтрока = "";
	Для Индекс = 1 По Длина Цикл
		ШестнадцатеричнаяСтрока = ШестнадцатеричнаяСтрока + "00";
	КонецЦикла;
	Данные = ПолучитьДвоичныеДанныеИзHexСтроки(ШестнадцатеричнаяСтрока);

	// Действие
	КодОшибки = КодИсключенияПриСозданииАдреса(Данные);

	// Проверка
	Ожидаем.Что(КодОшибки).Равно(КодыОшибокIP.НедопустимаяДлинаБайтов());

КонецПроцедуры

Процедура ПроверитьНедопустимыйОктет(Октет, ОжидаемыйКодОшибки)

	Октеты = Новый Массив;
	Октеты.Добавить(Октет);
	Октеты.Добавить(0);
	Октеты.Добавить(2);
	Октеты.Добавить(1);

	Ожидаем.Что(КодИсключенияПриСозданииАдреса(Октеты)).Равно(ОжидаемыйКодОшибки);

КонецПроцедуры

#КонецОбласти
