#Область Тесты

&Тест
Процедура ТестДолжен_РазобратьIPv4ПарсеромКакКлассом() Экспорт

	// Подготовка
	Парсер = Новый ПарсерIPv4Адресов();

	// Действие
	Октеты = Парсер.Разобрать("192.0.2.1");

	// Проверка
	Ожидаем.Что(Октеты[0]).Равно(192);
	Ожидаем.Что(Октеты[1]).Равно(0);
	Ожидаем.Что(Октеты[2]).Равно(2);
	Ожидаем.Что(Октеты[3]).Равно(1);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("0.0.0.0")
&ИсточникЗначение("1.2.3.4")
&ИсточникЗначение("10.0.0.1")
&ИсточникЗначение("127.0.0.1")
&ИсточникЗначение("192.0.2.1")
&ИсточникЗначение("255.255.255.255")
Процедура ТестДолжен_РазобратьСтрогийIPv4(Значение) Экспорт

	// Действие
	Адрес = Новый IPАдрес(Значение);

	// Проверка
	Ожидаем.Что(Адрес.ВСтроку()).Равно(Значение);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("01.2.3.4")
&ИсточникЗначение("001.2.3.4")
&ИсточникЗначение("256.1.1.1")
&ИсточникЗначение("1.2.3")
&ИсточникЗначение("1.2")
&ИсточникЗначение("1")
&ИсточникЗначение("0x7f.0.0.1")
&ИсточникЗначение("0177.0.0.1")
&ИсточникЗначение("+1.2.3.4")
&ИсточникЗначение("-1.2.3.4")
&ИсточникЗначение(" 1.2.3.4")
&ИсточникЗначение("1.2.3.4 ")
&ИсточникЗначение("١.2.3.4")
&ИсточникЗначение("１.2.3.4")
Процедура ТестДолжен_ОтклонитьНестрогийIPv4(Значение) Экспорт

	// Действие
	Ошибка = ОшибкаПриСозданииАдреса(Значение);

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, КодыОшибокIP.НедопустимыйIPv4());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ФорматироватьIPv4ИзОктетовБезНачальныхНулей() Экспорт

	// Подготовка
	Октеты = Новый Массив;
	Октеты.Добавить(1);
	Октеты.Добавить(2);
	Октеты.Добавить(3);
	Октеты.Добавить(4);

	// Действие
	СтрокаАдреса = Новый IPАдрес(Октеты).ВСтроку();

	// Проверка
	Ожидаем.Что(СтрокаАдреса).Равно("1.2.3.4");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВыдаватьIPv6ВФорматеIPv4() Экспорт

	// Подготовка
	Октеты = Новый Массив;
	Для Индекс = 1 По 16 Цикл
		Октеты.Добавить(0);
	КонецЦикла;
	Октеты[15] = 1;
	Адрес = Новый IPАдрес(Октеты);

	// Действие
	СтрокаАдреса = Адрес.ВСтроку();

	// Проверка
	Ожидаем.Что(СтрокаАдреса).Равно("::1");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьИмяУзлаКакНедопустимыйАдрес() Экспорт

	// Действие
	Ошибка = ОшибкаПриСозданииАдреса("localhost");

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, КодыОшибокIP.НедопустимыйIPАдрес());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьЗонуДляIPv4() Экспорт

	// Действие
	Ошибка = ОшибкаПриСозданииАдреса("192.0.2.1%eth0");

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, КодыОшибокIP.ЗонаНедопустимаДляIPv4());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьПустуюСтрокуКакНедопустимыйАдрес() Экспорт

	// Действие
	Ошибка = ОшибкаПриСозданииАдреса("");

	// Проверка
	ПомощникТестированияIP.ПроверитьКодОшибки(Ошибка, КодыОшибокIP.НедопустимыйIPАдрес());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаПриСозданииАдреса(Значение)

	Попытка
		Адрес = Новый IPАдрес(Значение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
